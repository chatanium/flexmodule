# Fixture-only derived image. The production runner overrides Entrypoint/Cmd;
# Docker merges these non-reserved image defaults with broker bootstrap Env.
ARG SANDBOX_BASE
FROM ${SANDBOX_BASE}
ARG FIXTURE_BOOTSTRAP_MODE
ARG FIXTURE_BOOTSTRAP_BYTES
ARG FIXTURE_BOOTSTRAP_TIMEOUT_SECONDS
ENV FLEXMODULE_FIXTURE_BOOTSTRAP_MODE=${FIXTURE_BOOTSTRAP_MODE} \
    FLEXMODULE_FIXTURE_BOOTSTRAP_BYTES=${FIXTURE_BOOTSTRAP_BYTES} \
    FLEXMODULE_FIXTURE_BOOTSTRAP_TIMEOUT_SECONDS=${FIXTURE_BOOTSTRAP_TIMEOUT_SECONDS}
