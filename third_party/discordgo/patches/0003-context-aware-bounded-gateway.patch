+package discordgo
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+)
+
+func TestGatewayContextAdmissionCancellation(t *testing.T) {
+	s, err := New("Bot host-only")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.wsMutex.Lock()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := s.UpdateStatusComplexContext(ctx, UpdateStatusData{}); !errors.Is(err, context.Canceled) {
+		t.Fatalf("writer admission: %v", err)
+	}
+	s.wsMutex.Unlock()
+	s.wsLifecycle.Lock()
+	if err := s.OpenContext(ctx); !errors.Is(err, context.Canceled) {
+		t.Fatalf("open admission: %v", err)
+	}
+	s.wsLifecycle.Unlock()
+	if err := s.UpdateStatusComplexContext(context.Background(), UpdateStatusData{}); !errors.Is(err, ErrWSNotFound) {
+		t.Fatalf("missing socket: %v", err)
+	}
+}
+
+func TestGatewayOpenContextAbortsHandshake(t *testing.T) {
+	exited := make(chan struct{})
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer close(exited)
+		defer conn.Close()
+		// Deliberately withhold Hello. Cancellation must close actual I/O.
+		_, _, _ = conn.ReadMessage()
+	}))
+	defer server.Close()
+	roots := x509.NewCertPool()
+	roots.AddCert(server.Certificate())
+	s, err := New("Bot host-only")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.Dialer = &websocket.Dialer{TLSClientConfig: &tls.Config{RootCAs: roots}}
+	s.gateway = "wss" + strings.TrimPrefix(server.URL, "https") + "/"
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := s.OpenContext(ctx); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("handshake cancellation: %v", err)
+	}
+	select {
+	case <-exited:
+	case <-time.After(time.Second):
+		t.Fatal("canceled handshake left server socket alive")
+	}
+	if s.wsConn != nil {
+		t.Fatal("failed handshake published a connection")
+	}
+}
+
+func TestGatewayURLNormalizationAndSecurity(t *testing.T) {
+	target, err := gatewayURL("wss://gateway.discord.gg/?v=9&encoding=etf")
+	if err != nil || target != "wss://gateway.discord.gg/?encoding=json&v=10" {
+		t.Fatalf("Gateway version: %q %v", target, err)
+	}
+	for _, insecure := range []string{"ws://gateway.discord.gg/", "https://gateway.discord.gg/", "wss://user:secret@gateway.discord.gg/"} {
+		if _, err := gatewayURL(insecure); err == nil {
+			t.Fatal("accepted insecure Gateway URL")
+		}
+	}
+}
+
+func TestGatewayObserverRawOrderingAndDetachedBefore(t *testing.T) {
+	s, err := New("Bot host-only")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.SyncEvents = true
+	s.State.MaxMessageCount = 5
+	if err := s.State.GuildAdd(&Guild{ID: "g"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.State.ChannelAdd(&Channel{ID: "c", GuildID: "g", Members: []*ThreadMember{{ID: "thread-member"}}}); err != nil {
+		t.Fatal(err)
+	}
+	old := &Message{ID: "m", ChannelID: "c", Content: "old", Author: &User{ID: "u", Username: "original"}, Components: []MessageComponent{&Button{Label: "old button"}}}
+	if err := s.State.MessageAdd(old); err != nil {
+		t.Fatal(err)
+	}
+	raw := `{"content":"","id":"m","channel_id":"c","attachments":[],"flags":0}`
+	observed := 0
+	var before *Message
+	s.SetDispatchObserver(func(session *Session, event *Event, decodeErr error) {
+		if decodeErr != nil {
+			t.Fatal(decodeErr)
+		}
+		if event.Type != "MESSAGE_UPDATE" || string(event.RawData) != raw {
+			t.Fatalf("raw payload changed: %s %s", event.Type, event.RawData)
+		}
+		// These locks must be available during host projection/admission.
+		session.State.RLock()
+		session.State.RUnlock()
+		session.RLock()
+		session.RUnlock()
+		before = event.Struct.(*MessageUpdate).BeforeUpdate
+		observed++
+	})
+	s.AddHandler(func(_ *Session, _ *MessageUpdate) {
+		if observed != 1 {
+			t.Fatal("ordinary handler preceded host observer")
+		}
+	})
+	if _, err := s.onEvent(websocket.TextMessage, []byte(`{"op":0,"s":1,"t":"MESSAGE_UPDATE","d":`+raw+`}`)); err != nil {
+		t.Fatal(err)
+	}
+	if observed != 1 || before == nil || before.Content != "old" {
+		t.Fatalf("before snapshot: %#v", before)
+	}
+	old.Author.Username = "changed"
+	old.Components[0].(*Button).Label = "changed"
+	if before.Author.Username != "original" || before.Components[0].(*Button).Label != "old button" {
+		t.Fatal("before snapshot aliases mutable cache")
+	}
+	// A channel snapshot includes SDK-only cached collections, not JSON loss.
+	channelBefore := s.cachedBefore(&ChannelUpdate{Channel: &Channel{ID: "c"}}).(*Channel)
+	if len(channelBefore.Messages) != 1 || len(channelBefore.Members) != 1 {
+		t.Fatal("SDK-only snapshot fields were discarded")
+	}
+	old.Content = "changed again"
+	if channelBefore.Messages[0].Content == "changed again" {
+		t.Fatal("nested channel snapshot aliases message cache")
+	}
+	s.SetDispatchObserver(nil)
+}
+
+func TestGatewayObserverMissingCacheAndDecodeFailure(t *testing.T) {
+	s, err := New("Bot host-only")
+	if err != nil {
+		t.Fatal(err)
+	}
+	count := 0
+	s.SetDispatchObserver(func(_ *Session, event *Event, decodeErr error) {
+		count++
+		switch count {
+		case 1:
+			if decodeErr != nil || event.Struct.(*MessageUpdate).BeforeUpdate != nil {
+				t.Fatal("manufactured missing before snapshot")
+			}
+		case 2:
+			if decodeErr == nil {
+				t.Fatal("decode error hidden from host")
+			}
+		case 3:
+			if event.Type != "UNKNOWN_HOST_ONLY" || event.Struct != nil {
+				t.Fatal("unknown event manufactured a typed payload")
+			}
+		}
+	})
+	if _, err := s.onEvent(websocket.TextMessage, []byte(`{"op":0,"s":1,"t":"MESSAGE_UPDATE","d":{"id":"missing","channel_id":"missing"}}`)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.onEvent(websocket.TextMessage, []byte(`{"op":0,"s":2,"t":"MESSAGE_UPDATE","d":{"flags":"invalid"}}`)); err == nil {
+		t.Fatal("expected decode failure")
+	}
+	if _, err := s.onEvent(websocket.TextMessage, []byte(`{"op":0,"s":3,"t":"UNKNOWN_HOST_ONLY","d":{"n":9007199254740993}}`)); err != nil {
+		t.Fatal(err)
+	}
+	if count != 3 {
+		t.Fatalf("observer count: %d", count)
+	}
+}
+
+func TestGatewayContextHandshakeAndTypedWrites(t *testing.T) {
+	type packet struct {
+		Op   int                        `json:"op"`
+		Data map[string]json.RawMessage `json:"d"`
+	}
+	writes := make(chan packet, 4)
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Query().Get("v") != "10" || r.URL.Query().Get("encoding") != "json" {
+			t.Error("wrong Gateway wire version")
+			return
+		}
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		if err := conn.WriteMessage(websocket.TextMessage, []byte(`{"op":10,"d":{"heartbeat_interval":60000}}`)); err != nil {
+			return
+		}
+		var identify packet
+		if err := conn.ReadJSON(&identify); err != nil {
+			return
+		}
+		if identify.Op != 2 {
+			t.Error("missing Identify")
+			return
+		}
+		if err := conn.WriteMessage(websocket.TextMessage, []byte(`{"op":0,"s":1,"t":"READY","d":{"v":10,"session_id":"private","user":{"id":"bot"},"guilds":[]}}`)); err != nil {
+			return
+		}
+		for {
+			var incoming struct {
+				Op   int             `json:"op"`
+				Data json.RawMessage `json:"d"`
+			}
+			if err := conn.ReadJSON(&incoming); err != nil {
+				return
+			}
+			if incoming.Op == 1 {
+				if err := conn.WriteMessage(websocket.TextMessage, []byte(`{"op":11,"d":null}`)); err != nil {
+					return
+				}
+				continue
+			}
+			p := packet{Op: incoming.Op}
+			if err := json.Unmarshal(incoming.Data, &p.Data); err != nil {
+				return
+			}
+			writes <- p
+		}
+	}))
+	defer server.Close()
+	roots := x509.NewCertPool()
+	roots.AddCert(server.Certificate())
+	s, err := New("Bot host-only")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.ShouldReconnectOnError = false
+	s.Dialer = &websocket.Dialer{TLSClientConfig: &tls.Config{RootCAs: roots}}
+	s.gateway = "wss" + strings.TrimPrefix(server.URL, "https") + "/"
+	openCtx, cancelOpen := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancelOpen()
+	if err := s.OpenContext(openCtx); err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	cancelOpen() // The successful open context is not the connection lifetime.
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	if err := s.UpdateStatusComplexContext(ctx, UpdateStatusData{Status: "online"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.RequestGuildMembersContext(ctx, "g", "", 0, "private-nonce", true); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.RequestGuildMembersListContext(ctx, "g", nil, 0, "private-nonce-2", false); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.ChannelVoiceJoinManualContext(ctx, "g", "", false, true); err != nil {
+		t.Fatal(err)
+	}
+	for index := range 4 {
+		var p packet
+		select {
+		case p = <-writes:
+		case <-ctx.Done():
+			t.Fatal("missing typed Gateway write")
+		}
+		switch index {
+		case 0:
+			if p.Op != 3 || string(p.Data["activities"]) != "[]" || string(p.Data["status"]) != `"online"` {
+				t.Fatal("status wire fields changed")
+			}
+		case 1:
+			if p.Op != 8 || string(p.Data["guild_id"]) != `"g"` || string(p.Data["query"]) != `""` || string(p.Data["limit"]) != "0" || string(p.Data["nonce"]) != `"private-nonce"` || string(p.Data["presences"]) != "true" || p.Data["user_ids"] != nil {
+				t.Fatal("query member selector changed")
+			}
+		case 2:
+			if p.Op != 8 || string(p.Data["guild_id"]) != `"g"` || string(p.Data["user_ids"]) != "[]" || p.Data["query"] != nil {
+				t.Fatal("user-ID member selector changed")
+			}
+		case 3:
+			if p.Op != 4 || string(p.Data["guild_id"]) != `"g"` || string(p.Data["channel_id"]) != "null" || string(p.Data["self_mute"]) != "false" || string(p.Data["self_deaf"]) != "true" {
+				t.Fatal("typed voice disconnect changed")
+			}
+		}
+	}
+}
diff --git a/gateway_dispatch.go b/gateway_dispatch.go
new file mode 100644
--- /dev/null
+++ b/gateway_dispatch.go
@@ -0,0 +1,234 @@
+package discordgo
+
+import "reflect"
+
+// SetDispatchObserver installs the single host ingress observer. Passing nil
+// detaches ingress/fatal callbacks and joins all callbacks already in flight.
+// For each Discord opcode-0 dispatch it runs synchronously, in receive order,
+// after internal state application and before ordinary SDK handlers. No Session,
+// State or handler lock is held while calling it. It includes host-private voice
+// events, not synthetic/raw duplicate events. RawData retains the exact d JSON;
+// Struct has detached BeforeUpdate/BeforeDelete only when actually cached.
+//
+// The host must bound its callback and project/enqueue synchronously; it must not
+// invoke module code, mutate the event/cache, reconfigure/detach callbacks, or
+// open/close this session from a callback. Decode errors are reported rather than silently projected as zero
+// values. Raw events and credentials must never cross the module boundary.
+func (s *Session) SetDispatchObserver(observer func(*Session, *Event, error)) {
+	s.dispatchMu.Lock()
+	s.dispatchObserver = observer
+	s.gatewayCallbacksDetached = observer == nil
+	s.dispatchMu.Unlock()
+}
+
+// snapshotVisit preserves shared references and cycles without sharing mutable
+// storage with the live cache. JSON cloning is incorrect here: SDK-only channel
+// messages/members and Message.Components deliberately have json:"-" tags.
+type snapshotVisit struct {
+	typ    reflect.Type
+	ptr    uintptr
+	length int
+}
+
+func cloneDispatchValue(v reflect.Value, seen map[snapshotVisit]reflect.Value) reflect.Value {
+	switch v.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			return reflect.Zero(v.Type())
+		}
+		key := snapshotVisit{typ: v.Type(), ptr: v.Pointer()}
+		if old, ok := seen[key]; ok {
+			return old
+		}
+		out := reflect.New(v.Type().Elem())
+		seen[key] = out
+		out.Elem().Set(cloneDispatchValue(v.Elem(), seen))
+		return out
+	case reflect.Interface:
+		if v.IsNil() {
+			return reflect.Zero(v.Type())
+		}
+		out := reflect.New(v.Type()).Elem()
+		out.Set(cloneDispatchValue(v.Elem(), seen))
+		return out
+	case reflect.Slice:
+		if v.IsNil() {
+			return reflect.Zero(v.Type())
+		}
+		key := snapshotVisit{typ: v.Type(), ptr: v.Pointer(), length: v.Len()}
+		if old, ok := seen[key]; ok {
+			return old
+		}
+		out := reflect.MakeSlice(v.Type(), v.Len(), v.Len())
+		seen[key] = out
+		for i := range v.Len() {
+			out.Index(i).Set(cloneDispatchValue(v.Index(i), seen))
+		}
+		return out
+	case reflect.Map:
+		if v.IsNil() {
+			return reflect.Zero(v.Type())
+		}
+		key := snapshotVisit{typ: v.Type(), ptr: uintptr(v.UnsafePointer())}
+		if old, ok := seen[key]; ok {
+			return old
+		}
+		out := reflect.MakeMapWithSize(v.Type(), v.Len())
+		seen[key] = out
+		iter := v.MapRange()
+		for iter.Next() {
+			out.SetMapIndex(iter.Key(), cloneDispatchValue(iter.Value(), seen))
+		}
+		return out
+	case reflect.Struct:
+		out := reflect.New(v.Type()).Elem()
+		// Unexported fields belong to immutable value types such as time.Time;
+		// copy those values without unsafe access to their implementation.
+		out.Set(v)
+		for i := range v.NumField() {
+			if v.Type().Field(i).IsExported() {
+				out.Field(i).Set(cloneDispatchValue(v.Field(i), seen))
+			}
+		}
+		return out
+	case reflect.Array:
+		out := reflect.New(v.Type()).Elem()
+		for i := range v.Len() {
+			out.Index(i).Set(cloneDispatchValue(v.Index(i), seen))
+		}
+		return out
+	default:
+		return v
+	}
+}
+
+// cachedBefore selects only source wrappers that actually define before fields,
+// and only when their corresponding cache tracking policy is enabled. It never
+// fetches a missing object or manufactures a before value from the new event.
+func (s *Session) cachedBefore(event interface{}) interface{} {
+	state := s.State
+	if state == nil || !s.StateEnabled {
+		return nil
+	}
+	state.RLock()
+	defer state.RUnlock()
+	var old interface{}
+	channel := func(id string, track bool) {
+		if track && state.channelMap[id] != nil {
+			old = state.channelMap[id]
+		}
+	}
+	member := func(guildID, userID string) {
+		if state.TrackMembers && state.memberMap[guildID][userID] != nil {
+			old = state.memberMap[guildID][userID]
+		}
+	}
+	role := func(guildID, roleID string) {
+		if guild := state.guildMap[guildID]; state.TrackRoles && guild != nil {
+			for _, value := range guild.Roles {
+				if value != nil && value.ID == roleID {
+					old = value
+					break
+				}
+			}
+		}
+	}
+	message := func(channelID, messageID string) {
+		if ch := state.channelMap[channelID]; state.MaxMessageCount != 0 && ch != nil {
+			for _, value := range ch.Messages {
+				if value != nil && value.ID == messageID {
+					old = value
+					break
+				}
+			}
+		}
+	}
+	switch e := event.(type) {
+	case *GuildDelete:
+		if e.Guild != nil && state.guildMap[e.ID] != nil {
+			old = state.guildMap[e.ID]
+		}
+	case *ChannelUpdate:
+		if e.Channel != nil {
+			channel(e.ID, state.TrackChannels)
+		}
+	case *ChannelDelete:
+		if e.Channel != nil {
+			channel(e.ID, state.TrackChannels)
+		}
+	case *ThreadUpdate:
+		if e.Channel != nil {
+			channel(e.ID, state.TrackThreads)
+		}
+	case *ThreadDelete:
+		if e.Channel != nil {
+			channel(e.ID, state.TrackThreads)
+		}
+	case *GuildMemberUpdate:
+		if e.Member != nil && e.User != nil {
+			member(e.GuildID, e.User.ID)
+		}
+	case *GuildMemberRemove:
+		if e.Member != nil && e.User != nil {
+			member(e.GuildID, e.User.ID)
+		}
+	case *GuildRoleUpdate:
+		if e.GuildRole != nil && e.Role != nil {
+			role(e.GuildID, e.Role.ID)
+		}
+	case *GuildRoleDelete:
+		role(e.GuildID, e.RoleID)
+	case *MessageUpdate:
+		if e.Message != nil {
+			message(e.ChannelID, e.ID)
+		}
+	case *MessageDelete:
+		if e.Message != nil {
+			message(e.ChannelID, e.ID)
+		}
+	case *VoiceStateUpdate:
+		if e.VoiceState != nil && state.TrackVoice {
+			if guild := state.guildMap[e.GuildID]; guild != nil {
+				for _, value := range guild.VoiceStates {
+					if value != nil && value.UserID == e.UserID {
+						old = value
+						break
+					}
+				}
+			}
+		}
+	}
+	if old == nil {
+		return nil
+	}
+	return cloneDispatchValue(reflect.ValueOf(old), make(map[snapshotVisit]reflect.Value)).Interface()
+}
+
+func setDispatchBefore(event, before interface{}) {
+	switch e := event.(type) {
+	case *GuildDelete:
+		e.BeforeDelete, _ = before.(*Guild)
+	case *ChannelUpdate:
+		e.BeforeUpdate, _ = before.(*Channel)
+	case *ChannelDelete:
+		e.BeforeDelete, _ = before.(*Channel)
+	case *ThreadUpdate:
+		e.BeforeUpdate, _ = before.(*Channel)
+	case *ThreadDelete:
+		e.BeforeDelete, _ = before.(*Channel)
+	case *GuildMemberUpdate:
+		e.BeforeUpdate, _ = before.(*Member)
+	case *GuildMemberRemove:
+		e.BeforeDelete, _ = before.(*Member)
+	case *GuildRoleUpdate:
+		e.BeforeUpdate, _ = before.(*Role)
+	case *GuildRoleDelete:
+		e.BeforeDelete, _ = before.(*Role)
+	case *MessageUpdate:
+		e.BeforeUpdate, _ = before.(*Message)
+	case *MessageDelete:
+		e.BeforeDelete, _ = before.(*Message)
+	case *VoiceStateUpdate:
+		e.BeforeUpdate, _ = before.(*VoiceState)
+	}
+}
diff --git a/gateway_ingress.go b/gateway_ingress.go
new file mode 100644
--- /dev/null
+++ b/gateway_ingress.go
@@ -0,0 +1,153 @@
+package discordgo
+
+import (
+	"bytes"
+	"compress/zlib"
+	"encoding/json"
+	"errors"
+	"io"
+	"unicode/utf8"
+
+	"github.com/gorilla/websocket"
+)
+
+// Ordinary standalone sessions created by New accept at most 8 MiB per wire
+// message and 32 MiB after decompression. Hosts must explicitly configure their
+// operator-selected bounds; these defaults are not backend configuration.
+const defaultGatewayFrameMaxBytes int64 = 8 << 20
+const defaultGatewayDecodedMaxBytes int64 = 32 << 20
+
+// ErrGatewayIngress is a fatal frame/decompression/envelope failure. It carries
+// no payload, token, URL, parser diagnostic or attacker-controlled text.
+var ErrGatewayIngress = errors.New("invalid or oversized Gateway ingress")
+
+// ConfigureGatewayIngress installs finite wire/decompressed byte bounds and a
+// host-only fatal callback before opening. It rejects an open or opening session
+// rather than waiting for its handshake. onFatal receives only ErrGatewayIngress
+// after the actual socket has been closed; invalid ingress never auto-reconnects.
+// Callbacks must be bounded and must not reconfigure, detach or open/close the
+// session recursively. SetDispatchObserver(nil) disables and joins both callback
+// kinds, so a host should cancel its lifetime before detaching during shutdown.
+func (s *Session) ConfigureGatewayIngress(frameMaxBytes, decodedMaxBytes int64, onFatal func(error)) error {
+	maxInt := int64(^uint(0) >> 1)
+	if frameMaxBytes <= 0 || decodedMaxBytes <= 0 || frameMaxBytes >= maxInt || decodedMaxBytes >= maxInt {
+		return errors.New("Gateway ingress limits must be positive finite byte counts")
+	}
+	if !s.wsLifecycle.tryLock() {
+		return ErrWSAlreadyOpen
+	}
+	defer s.wsLifecycle.Unlock()
+	s.Lock()
+	if s.wsConn != nil {
+		s.Unlock()
+		return ErrWSAlreadyOpen
+	}
+	s.gatewayFrameMaxBytes = frameMaxBytes
+	s.gatewayDecodedMaxBytes = decodedMaxBytes
+	s.gatewayFaulted = false
+	s.Unlock()
+	s.dispatchMu.Lock()
+	s.gatewayFatal = onFatal
+	s.gatewayCallbacksDetached = false
+	s.dispatchMu.Unlock()
+	return nil
+}
+
+func (s *Session) decodeGatewayEvent(messageType int, message []byte) (*Event, error) {
+	s.RLock()
+	frameMax, decodedMax := s.gatewayFrameMaxBytes, s.gatewayDecodedMaxBytes
+	s.RUnlock()
+	if frameMax <= 0 || decodedMax <= 0 || int64(len(message)) > frameMax {
+		return nil, ErrGatewayIngress
+	}
+	var raw []byte
+	switch messageType {
+	case websocket.TextMessage:
+		if int64(len(message)) > decodedMax {
+			return nil, ErrGatewayIngress
+		}
+		raw = message
+	case websocket.BinaryMessage:
+		compressed := bytes.NewReader(message)
+		z, err := zlib.NewReader(compressed)
+		if err != nil {
+			return nil, ErrGatewayIngress
+		}
+		// Enforce the decompressed bound before constructing JSON strings,
+		// RawMessage values, event structs or any typed domain allocations.
+		raw, err = io.ReadAll(io.LimitReader(z, decodedMax+1))
+		closeErr := z.Close()
+		if err != nil || closeErr != nil || int64(len(raw)) > decodedMax || compressed.Len() != 0 {
+			return nil, ErrGatewayIngress
+		}
+	default:
+		return nil, ErrGatewayIngress
+	}
+	if !utf8.Valid(raw) {
+		return nil, ErrGatewayIngress
+	}
+	var envelope struct {
+		Operation *int            `json:"op"`
+		Sequence  *int64          `json:"s"`
+		Type      *string         `json:"t"`
+		Data      json.RawMessage `json:"d"`
+	}
+	// Unmarshal requires one complete JSON value and rejects trailing values or
+	// non-whitespace bytes, unlike a single Decoder.Decode call.
+	if json.Unmarshal(raw, &envelope) != nil || envelope.Operation == nil || len(envelope.Data) == 0 {
+		return nil, ErrGatewayIngress
+	}
+	e := &Event{Operation: *envelope.Operation, RawData: envelope.Data}
+	if envelope.Sequence != nil {
+		e.Sequence = *envelope.Sequence
+	}
+	if envelope.Type != nil {
+		e.Type = *envelope.Type
+	}
+	if e.Operation == 0 && (envelope.Sequence == nil || e.Type == "") {
+		return nil, ErrGatewayIngress
+	}
+	return e, nil
+}
+
+func gatewayReadError(err error) error {
+	if errors.Is(err, websocket.ErrReadLimit) {
+		return ErrGatewayIngress
+	}
+	return err
+}
+
+// failGatewayIngress revokes this connection before closing it, so a heartbeat
+// woken by the close cannot mistake this failure for permission to reconnect.
+func (s *Session) failGatewayIngress(conn *websocket.Conn) {
+	s.Lock()
+	alreadyFailed := s.gatewayFaulted
+	s.gatewayFaulted = true
+	if s.wsConn == conn {
+		s.wsConn = nil
+		s.DataReady = false
+		if s.listening != nil {
+			close(s.listening)
+			s.listening = nil
+		}
+	}
+	voices := make([]*VoiceConnection, 0, len(s.VoiceConnections))
+	for _, voice := range s.VoiceConnections {
+		voices = append(voices, voice)
+	}
+	s.Unlock()
+	_ = conn.Close()
+	for _, voice := range voices {
+		voice.engine.stop(ErrGatewayIngress)
+	}
+	if alreadyFailed {
+		return
+	}
+	s.dispatchSerial.Lock()
+	defer s.dispatchSerial.Unlock()
+	s.dispatchMu.RLock()
+	defer s.dispatchMu.RUnlock()
+	if !s.gatewayCallbacksDetached && s.gatewayFatal != nil {
+		s.gatewayFatal(ErrGatewayIngress)
+	}
+}
diff --git a/gateway_ingress_test.go b/gateway_ingress_test.go
new file mode 100644
--- /dev/null
+++ b/gateway_ingress_test.go
@@ -0,0 +1,358 @@
+package discordgo
+
+import (
+	"bytes"
+	"compress/zlib"
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+)
+
+func compressedGatewayFixture(t *testing.T, raw []byte) []byte {
+	t.Helper()
+	var out bytes.Buffer
+	z := zlib.NewWriter(&out)
+	if _, err := z.Write(raw); err != nil {
+		t.Fatal(err)
+	}
+	if err := z.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return out.Bytes()
+}
+
+func configuredGatewayFixture(t *testing.T, server *httptest.Server, frame, decoded int64, fatal func(error)) *Session {
+	t.Helper()
+	s, err := New("Bot host-only")
+	if err != nil {
+		t.Fatal(err)
+	}
+	roots := x509.NewCertPool()
+	roots.AddCert(server.Certificate())
+	s.Dialer = &websocket.Dialer{TLSClientConfig: &tls.Config{RootCAs: roots}}
+	s.gateway = "wss" + strings.TrimPrefix(server.URL, "https") + "/"
+	if err := s.ConfigureGatewayIngress(frame, decoded, fatal); err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+func gatewayFixtureHandshake(conn *websocket.Conn) error {
+	if err := conn.WriteMessage(websocket.TextMessage, []byte(`{"op":10,"d":{"heartbeat_interval":60000}}`)); err != nil {
+		return err
+	}
+	if _, _, err := conn.ReadMessage(); err != nil {
+		return err
+	}
+	return conn.WriteMessage(websocket.TextMessage, []byte(`{"op":0,"s":1,"t":"READY","d":{"v":10,"session_id":"private","user":{"id":"bot"},"guilds":[]}}`))
+}
+
+func TestGatewayIngressBoundedDecompressionAndStrictEnvelope(t *testing.T) {
+	s, err := New("Bot host-only")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.ConfigureGatewayIngress(4096, 160, nil); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"MESSAGE_CREATE", "UNKNOWN_HOST_ONLY"} {
+		raw := []byte(`{"op":0,"s":1,"t":"` + name + `","d":{"content":"` + strings.Repeat("private-secret", 100) + `"}}`)
+		compressed := compressedGatewayFixture(t, raw)
+		if len(compressed) >= 160 {
+			t.Fatal("fixture did not exercise decompression expansion")
+		}
+		for _, frame := range []struct {
+			kind int
+			data []byte
+		}{{websocket.TextMessage, raw}, {websocket.BinaryMessage, compressed}} {
+			if _, err := s.decodeGatewayEvent(frame.kind, frame.data); !errors.Is(err, ErrGatewayIngress) {
+				t.Fatalf("unbounded %s input: %v", name, err)
+			}
+		}
+	}
+	valid := []byte(`{"op":0,"s":2,"t":"UNKNOWN_HOST_ONLY","d":{"n":9007199254740993,"zero":0}}`)
+	if err := s.ConfigureGatewayIngress(4096, int64(len(valid)), nil); err != nil {
+		t.Fatal(err)
+	}
+	for _, frame := range []struct {
+		kind int
+		data []byte
+	}{{websocket.TextMessage, valid}, {websocket.BinaryMessage, compressedGatewayFixture(t, valid)}} {
+		e, err := s.decodeGatewayEvent(frame.kind, frame.data)
+		if err != nil || string(e.RawData) != `{"n":9007199254740993,"zero":0}` {
+			t.Fatalf("exact bounded JSON changed: %v", err)
+		}
+	}
+	if err := s.ConfigureGatewayIngress(4096, 4096, nil); err != nil {
+		t.Fatal(err)
+	}
+	for _, raw := range [][]byte{
+		append(bytes.Clone(valid), []byte(` {}`)...),
+		[]byte(`{"op":0,"s":1,"t":"MESSAGE_CREATE","d":`),
+		[]byte(`{"s":1,"t":"UNKNOWN_HOST_ONLY","d":{}}`),
+		[]byte(`{"op":0,"s":1,"d":{}}`),
+		[]byte(`null`),
+		{'{', '"', 'o', 'p', '"', ':', '0', ',', '"', 'd', '"', ':', '"', 0xff, '"', '}'},
+	} {
+		for _, frame := range []struct {
+			kind int
+			data []byte
+		}{{websocket.TextMessage, raw}, {websocket.BinaryMessage, compressedGatewayFixture(t, raw)}} {
+			if _, err := s.decodeGatewayEvent(frame.kind, frame.data); !errors.Is(err, ErrGatewayIngress) {
+				t.Fatalf("malformed outer JSON accepted: %v", err)
+			}
+		}
+	}
+	compressed := compressedGatewayFixture(t, valid)
+	for _, corrupt := range [][]byte{compressed[:len(compressed)-1], append(bytes.Clone(compressed), []byte("private-secret")...)} {
+		if _, err := s.decodeGatewayEvent(websocket.BinaryMessage, corrupt); !errors.Is(err, ErrGatewayIngress) {
+			t.Fatalf("invalid zlib frame accepted: %v", err)
+		}
+	}
+}
+
+func TestGatewayIngressWireLimitAppliesBeforeHello(t *testing.T) {
+	peerClosed := make(chan struct{})
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		defer close(peerClosed)
+		_ = conn.WriteMessage(websocket.TextMessage, []byte(`{"op":10,"d":{"heartbeat_interval":60000,"extra":"`+strings.Repeat("secret", 100)+`"}}`))
+		_, _, _ = conn.ReadMessage()
+	}))
+	defer server.Close()
+	fatal := make(chan error, 1)
+	s := configuredGatewayFixture(t, server, 128, 4096, func(err error) { fatal <- err })
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	if err := s.OpenContext(ctx); !errors.Is(err, ErrGatewayIngress) {
+		t.Fatalf("oversized Hello did not fail: %v", err)
+	}
+	select {
+	case err := <-fatal:
+		if err != ErrGatewayIngress {
+			t.Fatal("fatal diagnostic leaked source error")
+		}
+	case <-ctx.Done():
+		t.Fatal("missing fatal notification")
+	}
+	select {
+	case <-peerClosed:
+	case <-ctx.Done():
+		t.Fatal("oversized Hello did not close real socket")
+	}
+}
+
+func TestGatewayIngressFatalEstablishedFramesCloseSocket(t *testing.T) {
+	large := []byte(`{"op":0,"s":2,"t":"UNKNOWN_HOST_ONLY","d":{"secret":"` + strings.Repeat("private", 200) + `"}}`)
+	for _, test := range []struct {
+		name           string
+		kind           int
+		data           []byte
+		frame, decoded int64
+	}{
+		{"wire-size", websocket.TextMessage, large, 256, 4096},
+		{"expanded-size", websocket.BinaryMessage, compressedGatewayFixture(t, large), 4096, 256},
+		{"malformed-known-outer", websocket.TextMessage, []byte(`{"op":0,"s":2,"t":"MESSAGE_CREATE","d":`), 4096, 4096},
+		{"malformed-unknown-outer", websocket.TextMessage, []byte(`{"op":0,"s":2,"t":"UNKNOWN_HOST_ONLY","d":`), 4096, 4096},
+		{"trailing-json", websocket.TextMessage, []byte(`{"op":0,"s":2,"t":"UNKNOWN_HOST_ONLY","d":{}} {}`), 4096, 4096},
+		{"bad-zlib", websocket.BinaryMessage, []byte("private-secret-not-zlib"), 4096, 4096},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			send := make(chan struct{})
+			peerClosed := make(chan struct{})
+			server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+				if err != nil {
+					return
+				}
+				defer conn.Close()
+				defer close(peerClosed)
+				if gatewayFixtureHandshake(conn) != nil {
+					return
+				}
+				<-send
+				_ = conn.WriteMessage(test.kind, test.data)
+				for {
+					if _, _, err := conn.ReadMessage(); err != nil {
+						return
+					}
+				}
+			}))
+			defer server.Close()
+			fatal := make(chan error, 1)
+			s := configuredGatewayFixture(t, server, test.frame, test.decoded, func(err error) { fatal <- err })
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			if err := s.OpenContext(ctx); err != nil {
+				close(send)
+				t.Fatal(err)
+			}
+			defer s.Close()
+			close(send)
+			select {
+			case err := <-fatal:
+				if err != ErrGatewayIngress {
+					t.Fatal("unsafe fatal error")
+				}
+			case <-ctx.Done():
