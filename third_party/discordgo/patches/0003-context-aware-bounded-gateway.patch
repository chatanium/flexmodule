+			}
+			select {
+			case <-peerClosed:
+			case <-ctx.Done():
+				t.Fatal("failed ingress left socket alive")
+			}
+			if err := s.OpenContext(ctx); !errors.Is(err, ErrGatewayIngress) {
+				t.Fatalf("faulted session reopened/retried: %v", err)
+			}
+		})
+	}
