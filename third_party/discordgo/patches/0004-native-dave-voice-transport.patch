+func (v *VoiceConnection) requestDisconnectRelease() {
+	v.Lock()
+	v.releaseOnClose = true
+	closed := v.localClosed
+	v.Unlock()
+	if closed {
+		v.removeReservation()
+	}
+}
+func (v *VoiceConnection) finishLocalCleanup() {
+	v.Lock()
+	v.localClosed = true
+	release := v.releaseOnClose
+	v.Unlock()
+	if release {
+		v.removeReservation()
+	}
+}
