+//go:build voice && cgo
+
+#ifndef CHATANIUM_DAVE_BRIDGE_H
+#define CHATANIUM_DAVE_BRIDGE_H
+
+#include <dave/dave.h>
+#include <dave/flex_dave_ext.h>
+#include <stdlib.h>
+
+/* Only C-owned memory is retained by native callbacks. The callback records no
+ * source, reason, identity or key-bearing text. All session calls are serialized
+ * by Context; the MLS callbacks used here execute synchronously in those calls. */
+typedef struct flex_dave_failure flex_dave_failure;
+flex_dave_failure* flex_dave_failure_create(void);
+void flex_dave_failure_destroy(flex_dave_failure* state);
+void flex_dave_failure_reset(flex_dave_failure* state);
+bool flex_dave_failure_failed(flex_dave_failure* state);
+DAVESessionHandle flex_dave_session_create(flex_dave_failure* state);
+void flex_dave_suppress_logs(void);
+
+#endif
diff --git a/internal/dave/context.go b/internal/dave/context.go
new file mode 100644
--- /dev/null
+++ b/internal/dave/context.go
@@ -0,0 +1,473 @@
+//go:build voice && cgo
+
+// Package dave owns ephemeral libdave MLS and media contexts. It is deliberately
+// absent from ordinary builds; it never implements media cryptography itself.
+package dave
+
+/*
+#cgo CFLAGS: -std=c11
+#cgo LDFLAGS: -ldave
+#include "bridge.h"
+*/
+import "C"
+
+import (
+	"context"
+	"errors"
+	"runtime"
+	"strconv"
+	"sync"
+	"time"
+	"unsafe"
+)
+
+// Config has no defaults. Limits apply before native input allocations and
+// before copying native output into Go. Frame buffers remain caller-owned.
+type Config struct {
+	MaxParticipants        int
+	MaxDecryptors          int
+	MaxControlBytes        int
+	MaxProposalCount       int
+	MaxProposalBytes       int
+	MaxPreparedTransitions int
+	MaxTransitionBytes     int
+	MaxFrameBytes          int
+	MaxEncryptedFrameBytes int
+}
+
+var (
+	ErrConfig         = errors.New("dave: invalid finite bounds")
+	ErrClosed         = errors.New("dave: context closed")
+	ErrBounds         = errors.New("dave: resource bound exceeded")
+	ErrInput          = errors.New("dave: invalid control input")
+	ErrNative         = errors.New("dave: native operation failed")
+	ErrNotReady       = errors.New("dave: media context not ready")
+	ErrUnsupported    = errors.New("dave: unsupported protocol version")
+	ErrUnknownSender  = errors.New("dave: sender not recognized")
+	ErrBuffer         = errors.New("dave: insufficient output buffer")
+	ErrTransition     = errors.New("dave: invalid transition")
+	ErrAuthentication = errors.New("dave: frame authentication failed")
+)
+
+type ProposalOperation uint8
+
+const (
+	ProposalAppend ProposalOperation = iota
+	ProposalRevoke
+)
+
+// Wire is the official ABI's serialized commit followed by its optional welcome.
+// It is one opaque opcode-28 payload, not two independently framed messages.
+type CommitWelcome struct{ Wire []byte }
+
+type CommitResult uint8
+
+const (
+	CommitApplied CommitResult = iota
+	CommitIgnored
+	CommitFailed
+)
+
+// The C ABI's TransitionToKeyRatchet uses kDefaultTransitionDuration=10s. The
+// admission ledger here bounds retained native key domains within that window;
+// native decryptors, not Go, authenticate against and expire the old ratchets.
+const receiverTransitionWindow = 10 * time.Second
+
+type receiver struct {
+	handle     C.DAVEDecryptorHandle
+	epochs     []time.Time
+	generation uint64
+	retired    time.Time
+}
+
+type transition struct {
+	version    uint16
+	sender     C.DAVEKeyRatchetHandle
+	receivers  map[string]C.DAVEKeyRatchetHandle
+	prepared   bool
+	bytes      int
+	generation uint64
+}
+
+// Context serializes all MLS, frame, callback-state and close operations. No
+// native callback invokes Go, and no Go pointer is retained by libdave.
+type Context struct {
+	mu                     sync.Mutex
+	cfg                    Config
+	session                C.DAVESessionHandle
+	failure                *C.flex_dave_failure
+	encryptor              C.DAVEEncryptorHandle
+	closed                 bool
+	initialized            bool
+	established            bool
+	version                uint16
+	self                   string
+	participants           map[string]struct{}
+	roster                 map[string]struct{}
+	receivers              map[string]*receiver
+	transitions            map[uint16]*transition
+	transitionBytes        int
+	proposalScratch        []byte
+	active                 bool
+	activeID               uint16
+	generation             uint64
+	receivingGeneration    uint64
+	activeGeneration       uint64
+	keyPackageGeneration   uint64
+	pendingResetGeneration uint64
+	pendingResetVersion    uint16
+	ssrc                   uint32
+	ssrcBound              bool
+}
+
+var suppressLogs sync.Once
+
+func MaxSupportedProtocolVersion() uint16 {
+	// This adapter supports the currently pinned protocol, not an unreviewed
+	// future native release's additional protocols.
+	v := uint16(C.daveMaxSupportedProtocolVersion())
+	if v > 1 {
+		return 1
+	}
+	return v
+}
+
+func (cfg Config) Validate() error {
+	for _, n := range []int{cfg.MaxParticipants, cfg.MaxDecryptors,
+		cfg.MaxControlBytes, cfg.MaxProposalCount, cfg.MaxProposalBytes,
+		cfg.MaxPreparedTransitions, cfg.MaxTransitionBytes, cfg.MaxFrameBytes,
+		cfg.MaxEncryptedFrameBytes} {
+		if n <= 0 {
+			return ErrConfig
+		}
+	}
+	// Native control copies use Go's bounded length; frame-size arithmetic must
+	// leave room for the library's transform overhead without uintptr overflow.
+	maxInt := int(^uint(0) >> 1)
+	if cfg.MaxControlBytes > maxInt-1 || cfg.MaxFrameBytes > maxInt-cfg.MaxEncryptedFrameBytes ||
+		cfg.MaxFrameBytes > cfg.MaxEncryptedFrameBytes {
+		return ErrConfig
+	}
+	return nil
+}
+
+func New(cfg Config) (*Context, error) {
+	if err := cfg.Validate(); err != nil {
+		return nil, err
+	}
+	suppressLogs.Do(func() { C.flex_dave_suppress_logs() })
+	c := &Context{cfg: cfg, participants: make(map[string]struct{}),
+		roster: make(map[string]struct{}), receivers: make(map[string]*receiver),
+		transitions: make(map[uint16]*transition)}
+	c.failure = C.flex_dave_failure_create()
+	if c.failure == nil {
+		return nil, ErrNative
+	}
+	c.session = C.flex_dave_session_create(c.failure)
+	c.encryptor = C.daveEncryptorCreate()
+	if c.session == nil || c.encryptor == nil {
+		c.Close()
+		return nil, ErrNative
+	}
+	if !bool(C.flexDaveSessionSetProposalLimits(c.session, C.size_t(cfg.MaxProposalCount), C.size_t(cfg.MaxProposalBytes))) {
+		c.Close()
+		return nil, ErrConfig
+	}
+	C.daveEncryptorSetPassthroughMode(c.encryptor, C.bool(false))
+	n := C.daveEncryptorGetMaxCiphertextByteSize(c.encryptor, C.DAVE_MEDIA_TYPE_AUDIO, C.size_t(cfg.MaxFrameBytes))
+	if n > C.size_t(cfg.MaxEncryptedFrameBytes) || n < C.size_t(cfg.MaxFrameBytes) {
+		c.Close()
+		return nil, ErrConfig
+	}
+	return c, nil
+}
+
+func (c *Context) enter(ctx context.Context) error {
+	if ctx == nil {
+		return ErrInput
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	c.mu.Lock()
+	if c.closed {
+		c.mu.Unlock()
+		return ErrClosed
+	}
+	if err := ctx.Err(); err != nil {
+		c.mu.Unlock()
+		return err
+	}
+	return nil
+}
+
+func validID(id string) bool {
+	if len(id) == 0 || len(id) > 20 {
+		return false
+	}
+	n, err := strconv.ParseUint(id, 10, 64)
+	return err == nil && n != 0 && strconv.FormatUint(n, 10) == id
+}
+
+func pointer(b []byte) *C.uint8_t { return (*C.uint8_t)(unsafe.Pointer(unsafe.SliceData(b))) }
+
+func (c *Context) checkNative() error {
+	if bool(C.flex_dave_failure_failed(c.failure)) {
+		return ErrNative
+	}
+	return nil
+}
+
+func (c *Context) resetFailure() { C.flex_dave_failure_reset(c.failure) }
+
+func (c *Context) Initialize(ctx context.Context, version uint16, groupID, selfUserID string) error {
+	if err := c.enter(ctx); err != nil {
+		return err
+	}
+	defer c.mu.Unlock()
+	c.clearPendingReset()
+	if version == 0 || version > MaxSupportedProtocolVersion() {
+		return ErrUnsupported
+	}
+	if !validID(groupID) || !validID(selfUserID) {
+		return ErrInput
+	}
+	if c.initialized && c.self != selfUserID {
+		return ErrInput
+	}
+	if c.generation == ^uint64(0) {
+		return ErrBounds
+	}
+	group, _ := strconv.ParseUint(groupID, 10, 64)
+	self := C.CString(selfUserID)
+	if self == nil {
+		return ErrNative
+	}
+	defer C.free(unsafe.Pointer(self))
+	c.resetFailure()
+	C.daveSessionInit(c.session, C.uint16_t(version), C.uint64_t(group), self)
+	if err := c.checkNative(); err != nil {
+		return err
+	}
+	for id, t := range c.transitions {
+		destroyTransition(t)
+		delete(c.transitions, id)
+	}
+	c.transitionBytes = 0
+	c.version, c.self, c.initialized = version, selfUserID, true
+	c.established = false
+	c.generation++
+	c.keyPackageGeneration = 0
+	// Reset only MLS/pending state. Existing native media contexts remain valid
+	// until the gateway executes the new transition.
+	c.roster = map[string]struct{}{selfUserID: {}}
+	return nil
+}
+
+func (c *Context) SetProtocolVersion(ctx context.Context, version uint16) (resultErr error) {
+	if err := c.enter(ctx); err != nil {
+		return err
+	}
+	defer c.mu.Unlock()
+	c.clearPendingReset()
+	if !c.initialized {
+		return ErrNotReady
+	}
+	if version == 0 || version > MaxSupportedProtocolVersion() {
+		return ErrUnsupported
+	}
+	C.daveSessionSetProtocolVersion(c.session, C.uint16_t(version))
+	c.version = version
+	return nil
+}
+
+func (c *Context) SetExternalSender(ctx context.Context, senderPackage []byte) (resultErr error) {
+	if err := c.enter(ctx); err != nil {
+		return err
+	}
+	defer c.mu.Unlock()
+	c.clearPendingReset()
+	if len(senderPackage) == 0 || len(senderPackage) > c.cfg.MaxControlBytes {
+		return ErrBounds
+	}
+	// Replacing a pending group's sender after its media domain was activated
+	// would recreate that group within the same generation. Require a real reset.
+	if c.initialized && !c.established && c.activeGeneration == c.generation {
+		return ErrTransition
+	}
+	c.resetFailure()
+	C.daveSessionSetExternalSender(c.session, pointer(senderPackage), C.size_t(len(senderPackage)))
+	runtime.KeepAlive(senderPackage)
+	return c.checkNative()
+}
+
+func (c *Context) copyOutput(p *C.uint8_t, n C.size_t, required bool) ([]byte, error) {
+	if p != nil {
+		defer C.daveFree(unsafe.Pointer(p))
+	}
+	if n > C.size_t(c.cfg.MaxControlBytes) {
+		return nil, ErrBounds
+	}
+	if n == 0 {
+		if required {
+			return nil, ErrNative
+		}
+		return nil, nil
+	}
+	if p == nil {
+		return nil, ErrNative
+	}
+	out := make([]byte, int(n))
+	copy(out, unsafe.Slice((*byte)(unsafe.Pointer(p)), int(n)))
+	return out, nil
+}
+
+func (c *Context) FreshKeyPackage(ctx context.Context) ([]byte, error) {
+	if err := c.enter(ctx); err != nil {
+		return nil, err
+	}
+	defer c.mu.Unlock()
+	c.clearPendingReset()
+	if !c.initialized {
+		return nil, ErrNotReady
+	}
+	// Native replaces the previous private join package even if output fails
+	// our copy bound; an older package must not authorize pending activation.
+	c.keyPackageGeneration = 0
+	var p *C.uint8_t
+	var n C.size_t
+	c.resetFailure()
+	C.daveSessionGetMarshalledKeyPackage(c.session, &p, &n)
+	if err := c.checkNative(); err != nil {
+		if p != nil {
+			C.daveFree(unsafe.Pointer(p))
+		}
+		return nil, err
+	}
+	out, err := c.copyOutput(p, n, true)
+	if err == nil {
+		c.keyPackageGeneration = c.generation
+	}
+	return out, err
+}
+
+func (c *Context) setParticipants(ids []string) error {
+	if len(ids) > c.cfg.MaxParticipants {
+		return ErrBounds
+	}
+	next := make(map[string]struct{}, len(ids))
+	for _, id := range ids {
+		if !validID(id) {
+			return ErrInput
+		}
+		if _, exists := next[id]; exists {
+			return ErrInput
+		}
+		next[id] = struct{}{}
+	}
+	c.participants = next
+	if c.self != "" {
+		if _, selfPresent := next[c.self]; !selfPresent {
+			c.clearPendingReset()
+		}
+	}
+	for id, r := range c.receivers {
+		if _, exists := next[id]; !exists {
+			C.daveDecryptorDestroy(r.handle)
+			delete(c.receivers, id)
+		}
+	}
+	return nil
+}
+
+func (c *Context) SetParticipants(ctx context.Context, ids []string) (resultErr error) {
+	if err := c.enter(ctx); err != nil {
+		return err
+	}
+	defer c.mu.Unlock()
+	defer c.clearPendingResetOnError(&resultErr)
+	return c.setParticipants(ids)
+}
+
+// recognizedArray returns C-owned pointer storage AND C-owned strings. Native
+// constructors copy them synchronously; none is retained after this call.
+func recognizedArray(ids []string) (array **C.char, release func(), err error) {
+	count := len(ids)
+	if count == 0 {
+		// The official C++ binding constructs a range even for an empty set.
+		// Supply a valid zero-length range rather than nullptr arithmetic.
+		count = 1
+	}
+	mem := C.calloc(C.size_t(count), C.size_t(unsafe.Sizeof(uintptr(0))))
+	if mem == nil {
+		return nil, nil, ErrNative
+	}
+	array = (**C.char)(mem)
+	slots := unsafe.Slice(array, count)
+	release = func() {
+		for _, p := range slots {
+			if p != nil {
+				C.free(unsafe.Pointer(p))
+			}
+		}
+		C.free(mem)
+	}
+	for i, id := range ids {
+		slots[i] = C.CString(id)
+		if slots[i] == nil {
+			release()
+			return nil, nil, ErrNative
+		}
+	}
+	return array, release, nil
+}
+
+func destroyTransition(t *transition) {
+	if t.sender != nil {
+		C.daveKeyRatchetDestroy(t.sender)
+		t.sender = nil
+	}
+	for id, r := range t.receivers {
+		C.daveKeyRatchetDestroy(r)
+		delete(t.receivers, id)
+	}
+}
+
+func (c *Context) Close() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed {
+		return nil
+	}
+	c.closed = true
+	c.clearPendingReset()
+	// Lock acquisition joins all admitted operations and their synchronous MLS
+	// callbacks. No fingerprint/asynchronous callbacks are ever registered.
+	for id, t := range c.transitions {
+		destroyTransition(t)
+		delete(c.transitions, id)
+	}
+	for id, r := range c.receivers {
+		C.daveDecryptorDestroy(r.handle)
+		delete(c.receivers, id)
+	}
+	if c.encryptor != nil {
+		C.daveEncryptorDestroy(c.encryptor)
+		c.encryptor = nil
+	}
+	if c.session != nil {
+		C.daveSessionDestroy(c.session)
+		c.session = nil
+	}
+	// Destroy callback memory only after the native session can no longer call it.
+	if c.failure != nil {
+		C.flex_dave_failure_destroy(c.failure)
+		c.failure = nil
+	}
+	c.participants, c.roster = nil, nil
+	c.self, c.version, c.active = "", 0, false
+	c.transitionBytes = 0
+	clear(c.proposalScratch)
+	c.proposalScratch = nil
+	return nil
+}
diff --git a/internal/dave/context_test.go b/internal/dave/context_test.go
new file mode 100644
--- /dev/null
+++ b/internal/dave/context_test.go
@@ -0,0 +1,258 @@
+//go:build voice && cgo
+
+package dave
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"errors"
+	"sync"
+	"testing"
+)
+
+func nativeTestConfig() Config {
+	return Config{MaxParticipants: 8, MaxDecryptors: 8, MaxControlBytes: 65536,
+		MaxProposalCount: 16, MaxProposalBytes: 65536, MaxPreparedTransitions: 8,
+		MaxTransitionBytes: 65536, MaxFrameBytes: 1275, MaxEncryptedFrameBytes: 1536}
+}
+
+// Public SEC1 P256 generator + BasicCredential{00,01,01,00}. Serialization follows
+// pinned MLSpp ExternalSender/SignaturePublicKey/Credential and the official
+// cpp/test/external_sender.cpp credential. No private key or persisted fixture.
+func externalSenderFixture(t *testing.T) []byte {
+	t.Helper()
+	p, err := hex.DecodeString("4041046b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c2964fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f500010400010100")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func newNativeTestContext(t *testing.T) *Context {
+	t.Helper()
+	c, err := New(nativeTestConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := c.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return c
+}
+
+func TestNativeBoundsAndUnavailableMedia(t *testing.T) {
+	if _, err := New(Config{}); !errors.Is(err, ErrConfig) {
+		t.Fatalf("missing bounds: %v", err)
+	}
+	c := newNativeTestContext(t)
+	ctx := context.Background()
+	if c.Ready() {
+		t.Fatal("new context published readiness")
+	}
+	if _, err := c.EncryptOpus(ctx, 1, []byte{0xf8, 0xff, 0xfe}, make([]byte, 1536)); !errors.Is(err, ErrNotReady) {
+		t.Fatalf("media without key: %v", err)
+	}
+	if _, err := c.MaxCiphertextSize(1276); !errors.Is(err, ErrBounds) {
+		t.Fatalf("unbounded frame: %v", err)
+	}
+	if err := c.Initialize(ctx, 0, "1", "2"); !errors.Is(err, ErrUnsupported) {
+		t.Fatalf("plaintext version: %v", err)
+	}
+	if err := c.Initialize(ctx, 1, "01", "2"); !errors.Is(err, ErrInput) {
+		t.Fatalf("noncanonical identity: %v", err)
+	}
+	if err := c.SetExternalSender(ctx, make([]byte, nativeTestConfig().MaxControlBytes+1)); !errors.Is(err, ErrBounds) {
+		t.Fatalf("native input allocation bound: %v", err)
+	}
+	if err := c.SetParticipants(ctx, []string{"2", "2"}); !errors.Is(err, ErrInput) {
+		t.Fatalf("duplicate participant: %v", err)
+	}
+	if _, err := c.DecryptOpus(ctx, "3", []byte{1, 2, 3}, make([]byte, 1536)); !errors.Is(err, ErrUnknownSender) {
+		t.Fatalf("unknown sender: %v", err)
+	}
+}
+
+func TestNativeFreshPackagesAndIgnoredCommit(t *testing.T) {
+	c := newNativeTestContext(t)
+	ctx := context.Background()
+	if err := c.Initialize(ctx, 1, "1", "2"); err != nil {
+		t.Fatal(err)
+	}
+	first, err := c.FreshKeyPackage(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := c.FreshKeyPackage(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(first) == 0 || bytes.Equal(first, second) {
+		t.Fatal("key package was reused")
+	}
+	// Upstream explicitly ignores an in-flight commit while there is neither
+	// current state nor proposals, despite invoking its failure callback.
+	result, err := c.ProcessCommit(ctx, 7, []byte{0xff})
+	if err != nil || result != CommitIgnored {
+		t.Fatalf("ignored became failed: %v %v", result, err)
+	}
+	if c.Ready() {
+		t.Fatal("ignored commit published readiness")
+	}
+}
+
+func TestNativePendingTransitionAndSoleMemberReset(t *testing.T) {
+	c := newNativeTestContext(t)
+	ctx := context.Background()
+	if err := c.Initialize(ctx, 1, "1", "2"); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.PrepareTransition(ctx, 0, 1); !errors.Is(err, ErrNotReady) {
+		t.Fatalf("group without sender: %v", err)
+	}
+	if err := c.SetExternalSender(ctx, externalSenderFixture(t)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.FreshKeyPackage(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.SetParticipants(ctx, []string{"2", "3"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.AuthorizePendingReset(ctx, 1); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.PrepareTransition(ctx, 0, 1); !errors.Is(err, ErrNotReady) {
+		t.Fatalf("non-sole pending activation: %v", err)
+	}
+	// A failed prepare consumed the authorization. Model another authenticated
+	// epoch-one reset and a successfully sent fresh package before authorizing.
+	if err := c.Initialize(ctx, 1, "1", "2"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.FreshKeyPackage(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.SetParticipants(ctx, []string{"2"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.PrepareTransition(ctx, 0, 1); !errors.Is(err, ErrNotReady) {
+		t.Fatalf("initial description/generated-only package authorized pending media: %v", err)
+	}
+	if err := c.AuthorizePendingReset(ctx, 1); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.PrepareTransition(ctx, 0, 1); err != nil {
+		t.Fatal(err)
+	}
+	if !c.Ready() || c.established {
+		t.Fatal("pending media activation incorrectly established MLS or stayed unready")
+	}
+	opus := []byte{0xf8, 0xff, 0xfe}
+	dst := make([]byte, nativeTestConfig().MaxEncryptedFrameBytes)
+	n, err := c.EncryptOpus(ctx, 42, opus, dst)
+	if err != nil || n <= len(opus) || bytes.Equal(dst[:n], opus) {
+		t.Fatalf("real frame encryption failed: n=%d err=%v", n, err)
+	}
+	firstCiphertext := append([]byte(nil), dst[:n]...)
+	if err := c.PrepareTransition(ctx, 0, 1); err != nil {
+		t.Fatal(err)
+	}
+	n, err = c.EncryptOpus(ctx, 42, opus, dst)
+	if err != nil || bytes.Equal(firstCiphertext, dst[:n]) {
+		t.Fatalf("repeated zero reused sender nonce: %v", err)
+	}
+	// A reset prepares a new pending group but preserves the old active sender
+	// until the gateway's immediate transition zero.
+	oldGeneration := c.activeGeneration
+	if err := c.Initialize(ctx, 1, "1", "2"); err != nil {
+		t.Fatal(err)
+	}
+	if !c.Ready() || c.activeGeneration != oldGeneration {
+		t.Fatal("reset switched sender before execute")
+	}
+	if _, err := c.FreshKeyPackage(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.PrepareTransition(ctx, 0, 1); !errors.Is(err, ErrNotReady) {
+		t.Fatalf("previous generation authorized a fresh pending reset: %v", err)
+	}
+	if err := c.AuthorizePendingReset(ctx, 1); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.PrepareTransition(ctx, 0, 1); err != nil {
+		t.Fatal(err)
+	}
+	if c.activeGeneration == oldGeneration || c.established {
+		t.Fatal("sole member reset did not activate fresh pending media")
+	}
+	if _, err := c.EncryptOpus(ctx, 43, opus, dst); !errors.Is(err, ErrInput) {
+		t.Fatalf("unbounded SSRC codec map: %v", err)
+	}
+}
+
+func TestNativeEmptyProposalAndFailedCommit(t *testing.T) {
+	c := newNativeTestContext(t)
+	ctx := context.Background()
+	if err := c.Initialize(ctx, 1, "1", "2"); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.SetExternalSender(ctx, externalSenderFixture(t)); err != nil {
+		t.Fatal(err)
+	}
+	// An empty TLS list must not synthesize a local commit or activate media.
+	out, err := c.ProcessProposals(ctx, ProposalAppend, []byte{0}, []string{"2"})
+	if err != nil || len(out.Wire) != 0 || c.Ready() {
+		t.Fatalf("empty proposal result: %d %v", len(out.Wire), err)
+	}
+	result, err := c.ProcessCommit(ctx, 9, []byte{0xff})
+	if result != CommitFailed || !errors.Is(err, ErrNative) {
+		t.Fatalf("invalid commit not failed: %v %v", result, err)
+	}
+	// Reject a truncated vector in the single native parser; do not silently
+	// accept its framing or return a locally fabricated commit.
+	if _, err := c.ProcessProposals(ctx, ProposalAppend, []byte{4, 1}, []string{"2"}); !errors.Is(err, ErrNative) {
+		t.Fatalf("malformed proposal framing: %v", err)
+	}
+}
+
+func TestNativeCloseAndSynchronousCallbackOwnership(t *testing.T) {
+	c := newNativeTestContext(t)
+	ctx := context.Background()
+	if err := c.Initialize(ctx, 1, "1", "2"); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	for range 8 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			// Invalid external sender enters the real synchronous native MLS
+			// failure callback while Close competes for the same owner lock.
+			err := c.SetExternalSender(ctx, []byte{0xff})
+			if !errors.Is(err, ErrNative) && !errors.Is(err, ErrClosed) {
+				t.Errorf("callback boundary: %v", err)
+			}
+		}()
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	wg.Wait()
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if c.Ready() {
+		t.Fatal("closed native context remains ready")
+	}
+	if _, err := c.FreshKeyPackage(ctx); !errors.Is(err, ErrClosed) {
+		t.Fatalf("use after close: %v", err)
+	}
+	canceled, cancel := context.WithCancel(ctx)
+	cancel()
+	if err := c.Initialize(canceled, 1, "1", "2"); !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled native admission: %v", err)
+	}
+}
diff --git a/internal/dave/frames.go b/internal/dave/frames.go
new file mode 100644
--- /dev/null
+++ b/internal/dave/frames.go
@@ -0,0 +1,133 @@
+//go:build voice && cgo
+
+package dave
+
+/*
+#include "bridge.h"
+*/
+import "C"
+
+import (
+	"context"
+	"runtime"
+	"time"
+)
+
+func (c *Context) maxCiphertextSize(frameBytes int) (int, error) {
+	if frameBytes <= 0 || frameBytes > c.cfg.MaxFrameBytes {
+		return 0, ErrBounds
+	}
+	n := C.daveEncryptorGetMaxCiphertextByteSize(c.encryptor, C.DAVE_MEDIA_TYPE_AUDIO, C.size_t(frameBytes))
+	if n < C.size_t(frameBytes) || n > C.size_t(c.cfg.MaxEncryptedFrameBytes) {
+		return 0, ErrBounds
+	}
+	return int(n), nil
+}
+
+// MaxCiphertextSize can size a reusable caller buffer before media is ready.
+func (c *Context) MaxCiphertextSize(frameBytes int) (int, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed {
+		return 0, ErrClosed
+	}
+	return c.maxCiphertextSize(frameBytes)
+}
+
+func (c *Context) maxPlaintextSize(senderID string, frameBytes int) (int, error) {
+	if frameBytes <= 0 || frameBytes > c.cfg.MaxEncryptedFrameBytes {
+		return 0, ErrBounds
+	}
+	if _, known := c.participants[senderID]; !known {
+		return 0, ErrUnknownSender
+	}
+	c.expireReceivers(time.Now())
+	r := c.receivers[senderID]
+	if r == nil {
+		return 0, ErrNotReady
+	}
+	n := C.daveDecryptorGetMaxPlaintextByteSize(r.handle, C.DAVE_MEDIA_TYPE_AUDIO, C.size_t(frameBytes))
+	// Pinned libdave returns encryptedFrameSize as its upper bound. The scratch
+	// buffer may therefore exceed MaxFrameBytes, but authenticated Opus output
+	// is independently checked against MaxFrameBytes before release.
+	if n == 0 || n > C.size_t(c.cfg.MaxEncryptedFrameBytes) {
+		return 0, ErrBounds
+	}
+	return int(n), nil
+}
+
+func (c *Context) MaxPlaintextSize(senderID string, frameBytes int) (int, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed {
+		return 0, ErrClosed
+	}
+	return c.maxPlaintextSize(senderID, frameBytes)
+}
+
+func (c *Context) EncryptOpus(ctx context.Context, ssrc uint32, opus, dst []byte) (int, error) {
+	if err := c.enter(ctx); err != nil {
+		return 0, err
+	}
+	defer c.mu.Unlock()
+	if !c.active || !bool(C.daveEncryptorHasKeyRatchet(c.encryptor)) ||
+		bool(C.daveEncryptorIsPassthroughMode(c.encryptor)) {
+		return 0, ErrNotReady
+	}
+	n, err := c.maxCiphertextSize(len(opus))
+	if err != nil {
+		return 0, err
+	}
+	if len(dst) < n {
+		return 0, ErrBuffer
+	}
+	if c.ssrcBound && c.ssrc != ssrc {
+		return 0, ErrInput
+	}
+	if !c.ssrcBound {
+		C.daveEncryptorAssignSsrcToCodec(c.encryptor, C.uint32_t(ssrc), C.DAVE_CODEC_OPUS)
+		c.ssrc, c.ssrcBound = ssrc, true
+	}
+	var written C.size_t
+	result := C.daveEncryptorEncrypt(c.encryptor, C.DAVE_MEDIA_TYPE_AUDIO, C.uint32_t(ssrc),
+		pointer(opus), C.size_t(len(opus)), pointer(dst), C.size_t(n), &written)
+	runtime.KeepAlive(opus)
+	runtime.KeepAlive(dst)
+	if result != C.DAVE_ENCRYPTOR_RESULT_CODE_SUCCESS || written == 0 || written > C.size_t(n) {
+		clear(dst[:n])
+		return 0, ErrNative
+	}
+	return int(written), nil
+}
+
+func (c *Context) DecryptOpus(ctx context.Context, senderID string, encrypted, dst []byte) (int, error) {
+	if err := c.enter(ctx); err != nil {
+		return 0, err
+	}
+	defer c.mu.Unlock()
+	n, err := c.maxPlaintextSize(senderID, len(encrypted))
+	if err != nil {
+		return 0, err
+	}
+	if len(dst) < n {
+		return 0, ErrBuffer
+	}
+	// libdave has an intentional SFU synthesized-silence exception. This strict
+	// authenticated-Opus API never publishes an unauthenticated frame, including
+	// that exception. The transport may discard it, not turn it into media.
+	if len(encrypted) == 3 && encrypted[0] == 0xf8 && encrypted[1] == 0xff && encrypted[2] == 0xfe {
+		return 0, ErrAuthentication
+	}
+	r := c.receivers[senderID]
+	var written C.size_t
+	result := C.daveDecryptorDecrypt(r.handle, C.DAVE_MEDIA_TYPE_AUDIO,
+		pointer(encrypted), C.size_t(len(encrypted)), pointer(dst), C.size_t(n), &written)
+	runtime.KeepAlive(encrypted)
+	runtime.KeepAlive(dst)
+	if result != C.DAVE_DECRYPTOR_RESULT_CODE_SUCCESS || written == 0 ||
+		written > C.size_t(n) || written > C.size_t(c.cfg.MaxFrameBytes) {
+		clear(dst[:n])
+		return 0, ErrAuthentication
+	}
+	return int(written), nil
+}
diff --git a/internal/dave/proposals.go b/internal/dave/proposals.go
new file mode 100644
--- /dev/null
+++ b/internal/dave/proposals.go
@@ -0,0 +1,72 @@
+//go:build voice && cgo
+
+package dave
+
+/*
+#include "bridge.h"
+*/
+import "C"
+
+import (
+	"context"
+	"runtime"
+	"unsafe"
+)
+
+// ProcessProposals receives the TLS proposal/ref list excluding its operation
+// byte. The source-patched official parser enforces exact queued proposal count
+// and serialized-byte limits in its single parse/validation path.
+// On success, empty Wire means the actual native proposal queue is empty and
+// its outbound candidate was cleared. A nonempty queue synchronously produces
+// its candidate; native failures return errors, never successful deferred output.
+func (c *Context) ProcessProposals(ctx context.Context, operation ProposalOperation, proposals []byte, recognizedIDs []string) (out CommitWelcome, resultErr error) {
+	if err := c.enter(ctx); err != nil {
+		return CommitWelcome{}, err
+	}
+	defer c.mu.Unlock()
+	defer c.clearPendingResetOnError(&resultErr)
+	if !c.initialized {
+		return CommitWelcome{}, ErrNotReady
+	}
+	if operation != ProposalAppend && operation != ProposalRevoke {
+		return CommitWelcome{}, ErrInput
+	}
+	if len(proposals) == 0 {
+		return CommitWelcome{}, ErrInput
+	}
+	if len(proposals) >= c.cfg.MaxControlBytes || len(proposals) >= c.cfg.MaxProposalBytes {
+		return CommitWelcome{}, ErrBounds
+	}
+	if err := c.setParticipants(recognizedIDs); err != nil {
+		return CommitWelcome{}, err
+	}
+	recognized, release, err := recognizedArray(recognizedIDs)
+	if err != nil {
+		return CommitWelcome{}, err
+	}
+	defer release()
+	size := len(proposals) + 1
+	if len(c.proposalScratch) < size {
+		c.proposalScratch = make([]byte, size)
+	}
+	wire := c.proposalScratch[:size]
+	wire[0] = byte(operation)
+	copy(wire[1:], proposals)
+	var p *C.uint8_t
+	var n C.size_t
+	c.resetFailure()
+	C.daveSessionProcessProposals(c.session, pointer(wire), C.size_t(size), recognized,
+		C.size_t(len(recognizedIDs)), &p, &n)
+	runtime.KeepAlive(wire)
+	if err := c.checkNative(); err != nil {
+		if p != nil {
+			C.daveFree(unsafe.Pointer(p))
+		}
+		return CommitWelcome{}, err
+	}
+	result, err := c.copyOutput(p, n, false)
+	if err != nil {
+		return CommitWelcome{}, err
+	}
+	return CommitWelcome{Wire: result}, nil
+}
diff --git a/internal/dave/transitions.go b/internal/dave/transitions.go
new file mode 100644
--- /dev/null
+++ b/internal/dave/transitions.go
@@ -0,0 +1,464 @@
+//go:build voice && cgo
+
+package dave
+
+/*
+#include "bridge.h"
+*/
+import "C"
+
+import (
+	"context"
+	"runtime"
+	"strconv"
+	"time"
+	"unsafe"
+)
+
+func (c *Context) transitionAdmission(id uint16, bytes int) error {
+	if _, exists := c.transitions[id]; exists {
+		return ErrTransition
+	}
+	if len(c.transitions) >= c.cfg.MaxPreparedTransitions || bytes < 0 ||
+		bytes > c.cfg.MaxTransitionBytes-c.transitionBytes {
+		return ErrBounds
+	}
+	return nil
+}
+
+// applyRoster consumes the official CHANGES map, not a full-membership snapshot.
+// Empty member signatures indicate removals. Signatures stay native and are
+// freed without copying or exposing them outside this ownership boundary.
+func (c *Context) applyRoster(ids *C.uint64_t, count C.size_t, signature func(C.uint64_t, **C.uint8_t, *C.size_t)) error {
+	if ids != nil {
+		defer C.daveFree(unsafe.Pointer(ids))
+	}
+	// A change set can contain both all old removals and all new additions.
+	if count > C.size_t(c.cfg.MaxControlBytes/8) ||
+		uint64(count) > uint64(c.cfg.MaxParticipants)*2 {
+		return ErrBounds
+	}
+	if count != 0 && ids == nil {
+		return ErrNative
+	}
+	next := make(map[string]struct{}, len(c.roster))
+	for id := range c.roster {
+		next[id] = struct{}{}
+	}
+	for _, rawID := range unsafe.Slice(ids, int(count)) {
+		id := strconv.FormatUint(uint64(rawID), 10)
+		if !validID(id) {
+			return ErrNative
+		}
+		var p *C.uint8_t
+		var n C.size_t
+		signature(rawID, &p, &n)
+		if n > C.size_t(c.cfg.MaxControlBytes) || (n != 0 && p == nil) {
+			if p != nil {
+				C.daveFree(unsafe.Pointer(p))
+			}
+			return ErrBounds
+		}
+		if p != nil {
+			C.daveFree(unsafe.Pointer(p))
+		}
+		if n == 0 {
+			delete(next, id)
+			continue
+		}
+		if id != c.self {
+			if _, recognized := c.participants[id]; !recognized {
+				return ErrUnknownSender
+			}
+		}
+		next[id] = struct{}{}
+	}
+	if len(next) > c.cfg.MaxParticipants {
+		return ErrBounds
+	}
+	if _, exists := next[c.self]; !exists {
+		return ErrNative
+	}
+	c.roster = next
+	return nil
+}
+
+func (c *Context) ratchet(id string) (C.DAVEKeyRatchetHandle, error) {
+	user := C.CString(id)
+	if user == nil {
+		return nil, ErrNative
+	}
+	defer C.free(unsafe.Pointer(user))
+	h := C.daveSessionGetKeyRatchet(c.session, user)
+	if h == nil {
+		return nil, ErrNotReady
+	}
+	return h, nil
+}
+
+func (c *Context) snapshotTransition(id uint16, bytes int) error {
+	if err := c.transitionAdmission(id, bytes); err != nil {
+		return err
+	}
+	t := &transition{version: c.version, bytes: bytes, generation: c.generation,
+		receivers: make(map[string]C.DAVEKeyRatchetHandle)}
+	sender, err := c.ratchet(c.self)
+	if err != nil {
+		return err
+	}
+	t.sender = sender
+	for user := range c.roster {
+		if user == c.self {
+			continue
+		}
+		if _, recognized := c.participants[user]; !recognized {
+			continue
+		}
+		if len(t.receivers) >= c.cfg.MaxDecryptors {
+			destroyTransition(t)
+			return ErrBounds
+		}
+		h, err := c.ratchet(user)
+		if err != nil {
+			destroyTransition(t)
+			return err
+		}
+		t.receivers[user] = h
+	}
+	c.transitions[id] = t
+	c.transitionBytes += bytes
+	return nil
+}
+
+func (c *Context) ProcessCommit(ctx context.Context, transitionID uint16, commit []byte) (outcome CommitResult, resultErr error) {
+	if err := c.enter(ctx); err != nil {
+		return CommitFailed, err
+	}
+	defer c.mu.Unlock()
+	defer c.clearPendingResetOnError(&resultErr)
+	if !c.initialized {
+		return CommitFailed, ErrNotReady
+	}
+	if len(commit) == 0 || len(commit) > c.cfg.MaxControlBytes {
+		return CommitFailed, ErrBounds
+	}
+	if err := c.transitionAdmission(transitionID, len(commit)); err != nil {
+		return CommitFailed, err
+	}
+	if c.generation == ^uint64(0) {
+		return CommitFailed, ErrBounds
+	}
+	c.resetFailure()
+	result := C.daveSessionProcessCommit(c.session, pointer(commit), C.size_t(len(commit)))
+	runtime.KeepAlive(commit)
+	if result == nil {
+		return CommitFailed, ErrNative
+	}
+	defer C.daveCommitResultDestroy(result)
+	// The upstream ignored branch can invoke the failure callback. Check the
+	// semantic result first; ignored is explicitly not invalid-commit recovery.
+	if bool(C.daveCommitResultIsIgnored(result)) {
+		return CommitIgnored, nil
+	}
+	if bool(C.daveCommitResultIsFailed(result)) {
+		return CommitFailed, ErrNative
+	}
+	if err := c.checkNative(); err != nil {
+		return CommitFailed, err
+	}
+	var ids *C.uint64_t
+	var count C.size_t
+	C.daveCommitResultGetRosterMemberIds(result, &ids, &count)
+	if err := c.applyRoster(ids, count, func(id C.uint64_t, p **C.uint8_t, n *C.size_t) {
+		C.daveCommitResultGetRosterMemberSignature(result, id, p, n)
+	}); err != nil {
+		return CommitFailed, err
+	}
+	c.established = true
+	c.clearPendingReset()
+	c.generation++
+	if err := c.snapshotTransition(transitionID, len(commit)); err != nil {
+		return CommitFailed, err
+	}
+	return CommitApplied, nil
+}
+
+func (c *Context) ProcessWelcome(ctx context.Context, transitionID uint16, welcome []byte, recognizedIDs []string) (resultErr error) {
+	if err := c.enter(ctx); err != nil {
+		return err
+	}
+	defer c.mu.Unlock()
+	defer c.clearPendingResetOnError(&resultErr)
+	if !c.initialized {
+		return ErrNotReady
+	}
+	if len(welcome) == 0 || len(welcome) > c.cfg.MaxControlBytes {
+		return ErrBounds
+	}
+	if err := c.transitionAdmission(transitionID, len(welcome)); err != nil {
+		return err
+	}
+	if c.generation == ^uint64(0) {
+		return ErrBounds
+	}
+	if err := c.setParticipants(recognizedIDs); err != nil {
+		return err
+	}
+	recognized, release, err := recognizedArray(recognizedIDs)
+	if err != nil {
+		return err
+	}
+	defer release()
+	c.resetFailure()
+	result := C.daveSessionProcessWelcome(c.session, pointer(welcome), C.size_t(len(welcome)),
+		recognized, C.size_t(len(recognizedIDs)))
+	runtime.KeepAlive(welcome)
+	if result == nil {
+		return ErrNative
+	}
+	defer C.daveWelcomeResultDestroy(result)
+	if err := c.checkNative(); err != nil {
+		return err
+	}
+	var ids *C.uint64_t
+	var count C.size_t
+	C.daveWelcomeResultGetRosterMemberIds(result, &ids, &count)
+	if err := c.applyRoster(ids, count, func(id C.uint64_t, p **C.uint8_t, n *C.size_t) {
+		C.daveWelcomeResultGetRosterMemberSignature(result, id, p, n)
+	}); err != nil {
+		return err
+	}
+	c.established = true
+	c.clearPendingReset()
+	c.generation++
+	return c.snapshotTransition(transitionID, len(welcome))
+}
+
+func (c *Context) expireReceivers(now time.Time) {
+	for user, r := range c.receivers {
+		if !r.retired.IsZero() && !r.retired.After(now) {
+			C.daveDecryptorDestroy(r.handle)
+			delete(c.receivers, user)
+		}
+	}
+}
+
+func (c *Context) prepareReceivers(id uint16) error {
+	t := c.transitions[id]
+	if t == nil || t.generation < c.receivingGeneration {
+		return ErrTransition
+	}
+	if t.prepared {
+		return nil
+	}
+	now := time.Now()
+	c.expireReceivers(now)
+	additional := 0
+	for user := range t.receivers {
+		if _, recognized := c.participants[user]; !recognized {
+			continue
+		}
+		if r := c.receivers[user]; r != nil {
+			if r.generation == t.generation && r.retired.IsZero() {
+				continue
+			}
+			first := 0
+			for first < len(r.epochs) && !r.epochs[first].IsZero() && !r.epochs[first].After(now) {
+				first++
+			}
+			copy(r.epochs, r.epochs[first:])
+			r.epochs = r.epochs[:len(r.epochs)-first]
+			if len(r.epochs) >= c.cfg.MaxPreparedTransitions {
+				return ErrBounds
+			}
+		} else {
+			additional++
+		}
+	}
+	if additional > c.cfg.MaxDecryptors-len(c.receivers) {
+		return ErrBounds
+	}
+	// Allocate all required decryptors before mutating any existing ratchets.
+	created := make(map[string]*receiver, additional)
+	for user := range t.receivers {
+		if _, recognized := c.participants[user]; !recognized {
+			continue
+		}
+		if c.receivers[user] != nil {
+			continue
+		}
+		h := C.daveDecryptorCreate()
+		if h == nil {
+			for _, r := range created {
+				C.daveDecryptorDestroy(r.handle)
+			}
+			return ErrNative
+		}
+		// Native default is no passthrough. Never turn it on.
+		created[user] = &receiver{handle: h}
+	}
+	for user, r := range created {
+		c.receivers[user] = r
+	}
+	for user, r := range c.receivers {
+		if _, member := t.receivers[user]; member || !r.retired.IsZero() {
+			continue
+		}
+		// Removal expires the former active domain using the same official
+		// ten-second transition facility, without admitting plaintext.
+		C.daveDecryptorTransitionToKeyRatchet(r.handle, nil)
+		r.retired = now.Add(receiverTransitionWindow)
+		for i := range r.epochs {
+			if r.epochs[i].IsZero() {
+				r.epochs[i] = r.retired
+			}
+		}
+	}
+	for user, ratchet := range t.receivers {
+		if _, recognized := c.participants[user]; recognized {
+			r := c.receivers[user]
+			if r.generation != t.generation || !r.retired.IsZero() {
+				// The C ABI copies the key domain; input remains ours.
+				C.daveDecryptorTransitionToKeyRatchet(r.handle, ratchet)
+				for i := range r.epochs {
+					if r.epochs[i].IsZero() {
+						r.epochs[i] = now.Add(receiverTransitionWindow)
+					}
+				}
+				r.epochs = append(r.epochs, time.Time{})
+				r.generation, r.retired = t.generation, time.Time{}
+			}
+		}
+		C.daveKeyRatchetDestroy(ratchet)
+		delete(t.receivers, user)
+	}
+	c.receivingGeneration = t.generation
+	t.prepared = true
+	return nil
+}
+
+func (c *Context) PrepareReceivers(ctx context.Context, transitionID uint16) (resultErr error) {
+	if err := c.enter(ctx); err != nil {
+		return err
+	}
+	defer c.mu.Unlock()
+	defer c.clearPendingResetOnError(&resultErr)
+	if err := c.prepareReceivers(transitionID); err != nil {
+		return err
+	}
+	if transitionID == 0 {
+		return c.executeTransition(transitionID)
+	}
+	return nil
+}
+
+// PrepareTransition handles opcode 21, including immediate transition zero. A
+// commit/welcome transition has already snapshotted its own native key domains.
+func (c *Context) PrepareTransition(ctx context.Context, transitionID, version uint16) (resultErr error) {
+	if err := c.enter(ctx); err != nil {
+		return err
+	}
+	defer c.mu.Unlock()
+	defer c.clearPendingResetOnError(&resultErr)
+	if !c.initialized {
+		return ErrNotReady
+	}
+	if version == 0 || version > MaxSupportedProtocolVersion() {
+		return ErrUnsupported
+	}
+	if transitionID != 0 {
+		c.clearPendingReset()
+	}
+	if t := c.transitions[transitionID]; t != nil {
+		if t.version != version {
+			return ErrTransition
+		}
+	} else {
+		C.daveSessionSetProtocolVersion(c.session, C.uint16_t(version))
+		c.version = version
+		if transitionID == 0 && !c.established {
+			if c.active && c.activeGeneration == c.generation && c.activeID == 0 {
+				c.clearPendingReset()
+				return nil
+			}
+			if c.pendingResetGeneration != c.generation || c.pendingResetVersion != version {
+				return ErrNotReady
+			}
+			if c.keyPackageGeneration != c.generation || len(c.participants) != 1 {
+				return ErrNotReady
+			}
+			if _, soleSelf := c.participants[c.self]; !soleSelf {
+				return ErrNotReady
+			}
+			c.clearPendingReset()
+			if !bool(C.flexDaveSessionActivatePendingGroup(c.session)) {
+				return ErrNotReady
+			}
+		}
+		if err := c.snapshotTransition(transitionID, 0); err != nil {
+			return err
+		}
+	}
+	if err := c.prepareReceivers(transitionID); err != nil {
+		return err
+	}
+	if transitionID == 0 {
+		return c.executeTransition(transitionID)
+	}
+	return nil
+}
+
+func (c *Context) executeTransition(id uint16) error {
+	t := c.transitions[id]
+	if t == nil {
+		if c.active && c.activeID == id {
+			return nil
+		}
+		return ErrTransition
+	}
+	if !t.prepared || t.sender == nil {
+		return ErrNotReady
+	}
+	if t.generation < c.activeGeneration {
+		return ErrTransition
+	}
+	if t.generation != c.activeGeneration {
+		C.daveEncryptorSetKeyRatchet(c.encryptor, t.sender)
+	}
+	C.daveKeyRatchetDestroy(t.sender)
+	t.sender = nil
+	if !bool(C.daveEncryptorHasKeyRatchet(c.encryptor)) || bool(C.daveEncryptorIsPassthroughMode(c.encryptor)) {
+		return ErrNative
+	}
+	c.active, c.activeID = true, id
+	c.activeGeneration = t.generation
+	c.transitionBytes -= t.bytes
+	destroyTransition(t)
+	delete(c.transitions, id)
+	// An executed newer domain makes older prepared sender contexts obsolete.
+	// Receiver in-flight retention remains in the official decryptors.
+	for oldID, old := range c.transitions {
+		if old.generation < c.activeGeneration {
+			c.transitionBytes -= old.bytes
+			destroyTransition(old)
+			delete(c.transitions, oldID)
+		}
+	}
+	return nil
+}
+
+func (c *Context) ExecuteTransition(ctx context.Context, transitionID uint16) (resultErr error) {
+	if err := c.enter(ctx); err != nil {
+		return err
+	}
+	defer c.mu.Unlock()
+	defer c.clearPendingResetOnError(&resultErr)
+	return c.executeTransition(transitionID)
+}
+
+func (c *Context) Ready() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return !c.closed && c.active && bool(C.daveEncryptorHasKeyRatchet(c.encryptor)) &&
+		!bool(C.daveEncryptorIsPassthroughMode(c.encryptor))
+}
