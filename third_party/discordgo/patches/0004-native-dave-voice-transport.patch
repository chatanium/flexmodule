+		MaxWebSocketBytes: 65536, MaxControlMessages: 16, MaxParticipants: 16, MaxDecryptors: 16, MaxProposalBytes: 16384, MaxProposals: 16, MaxTransitions: 8, MaxTransitionBytes: 32768, MaxOpusBytes: 1275, MaxEncryptedFrameBytes: 1536, MaxUDPPacketBytes: 2048, ReceiveQueuePackets: 16, ReceiveQueueBytes: 20400,
+		HandshakeTimeout: time.Second, RekeyTimeout: time.Second, WriteTimeout: time.Second, UDPDiscoveryTimeout: time.Second, UDPKeepAliveInterval: time.Second, HeartbeatTimeout: time.Second, SubmitTimeout: time.Second, ReceiptTimeout: time.Second, CloseTimeout: time.Second,
+	}
+}
+func TestVoiceConfigRequiresEveryFiniteBound(t *testing.T) {
+	good := voiceFixtureConfig()
+	if err := good.Validate(); err != nil {
+		t.Fatal(err)
+	}
+	cases := []VoiceConfig{{}, good, good, good, good, good}
+	cases[1].MaxControlMessages = 0
+	cases[2].RekeyTimeout = 0
+	cases[3].MaxUDPPacketBytes = 65508
+	cases[4].ReceiveQueueBytes = 1
+	cases[5].MaxProposalBytes = math.MaxInt
+	for i, c := range cases {
+		if c.Validate() == nil {
+			t.Fatalf("invalid configuration %d accepted", i)
+		}
+	}
+}
+func TestVoiceBinarySequenceAndDirection(t *testing.T) {
+	for _, op := range []byte{25, 27, 29, 30} {
+		wire := []byte{0xff, 0xff, op, 0x12, 0x34, 0xaa}
+		seq, got, payload, err := parseVoiceBinary(wire, 64)
+		if err != nil || seq != 65535 || got != op || !bytes.Equal(payload, wire[3:]) {
+			t.Fatalf("binary decode %d: seq=%d op=%d payload=%x err=%v", op, seq, got, payload, err)
+		}
+	}
+	for _, p := range [][]byte{nil, {25}, {0, 25}} {
+		if _, _, _, err := parseVoiceBinary(p, 64); err == nil {
+			t.Fatalf("truncated frame accepted %x", p)
+		}
+	}
+	if _, _, _, err := parseVoiceBinary([]byte{0, 1, 25, 0}, 3); err == nil {
+		t.Fatal("oversized binary frame accepted")
+	}
+	wire, err := voiceResumeWire("1", "session", "credential", 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(wire) != `{"op":7,"d":{"server_id":"1","session_id":"session","token":"credential","seq_ack":0}}` {
+		t.Fatalf("incorrect v8 Resume: %s", wire)
+	}
+	wire, err = voiceResumeWire("1", "session", "credential", 65535)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(wire, []byte(`"seq_ack":65535`)) {
+		t.Fatal("last binary sequence missing from Resume")
+	}
+}
+func TestVoiceEpochWireHasNoTransitionID(t *testing.T) {
+	b, err := json.Marshal(voicePrepareEpoch{Epoch: 1, Version: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(b) != `{"epoch":1,"protocol_version":1}` {
+		t.Fatalf("incorrect PrepareEpoch schema: %s", b)
+	}
+	b, err = json.Marshal(voiceHeartbeatData{T: 123, SeqAck: -1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(b) != `{"t":123,"seq_ack":-1}` {
+		t.Fatalf("incorrect v8 heartbeat: %s", b)
+	}
+}
+func TestVoiceModeNegotiationNoLegacyFallback(t *testing.T) {
+	for _, c := range []struct {
+		modes []string
+		want  string
+	}{
+		{[]string{voiceXChaChaMode, voiceAESMode}, voiceAESMode},
+		{[]string{voiceXChaChaMode}, voiceXChaChaMode},
+	} {
+		got, err := selectVoiceMode(c.modes)
+		if err != nil || got != c.want {
+			t.Fatalf("mode %q %v", got, err)
+		}
+	}
+	for _, mode := range []string{"xsalsa20_poly1305", "aead_aes256_gcm", "xsalsa20_poly1305_lite_rtpsize", ""} {
+		if _, err := selectVoiceMode([]string{mode}); err == nil {
+			t.Fatalf("legacy mode accepted %q", mode)
+		}
+		if _, err := voiceAEAD(mode, make([]byte, 32)); err == nil {
+			t.Fatalf("legacy AEAD constructed %q", mode)
+		}
+	}
+}
+func TestVoiceAEADRoundTripAndAuthentication(t *testing.T) {
+	for _, mode := range []string{voiceAESMode, voiceXChaChaMode} {
+		t.Run(mode, func(t *testing.T) {
+			aead, err := voiceAEAD(mode, bytes.Repeat([]byte{7}, 32))
+			if err != nil {
+				t.Fatal(err)
+			}
+			frame := []byte{0xaa, 0xbb, 0xcc, 0xdd}
+			dst := make([]byte, 0, 2048)
+			wire, err := sealVoiceRTP(dst, aead, 42, 65535, math.MaxUint32, 1234, frame)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(wire[len(wire)-4:], []byte{0, 0, 4, 0xd2}) {
+				t.Fatalf("nonce suffix must equal first4 nonce bytes: %x", wire)
+			}
+			plain, ssrc, seq, ts, err := openVoiceRTP(make([]byte, 2048), aead, wire)
+			if err != nil || !bytes.Equal(plain, frame) || ssrc != 42 || seq != 65535 || ts != math.MaxUint32 {
+				t.Fatalf("RTP roundtrip: %x %d %d %d %v", plain, ssrc, seq, ts, err)
+			}
+			for _, index := range []int{2, 4, 8, 12, len(wire) - 1} {
+				bad := append([]byte(nil), wire...)
+				bad[index] ^= 1
+				if _, _, _, _, err := openVoiceRTP(make([]byte, 2048), aead, bad); err == nil {
+					t.Fatalf("tampering at %d authenticated", index)
+				}
+			}
+			if _, err := sealVoiceRTP(dst, aead, 42, 0, 0, uint64(math.MaxUint32)+1, frame); err == nil {
+				t.Fatal("nonce wrapped")
+			}
+			if _, err := sealVoiceRTP(make([]byte, 0, 12), aead, 42, 0, 0, 0, frame); err == nil {
+				t.Fatal("undersized output accepted")
+			}
+		})
+	}
+}
+func TestVoiceAEADAuthenticatedExtensionsAndPadding(t *testing.T) {
+	for _, mode := range []string{voiceAESMode, voiceXChaChaMode} {
+		t.Run(mode, func(t *testing.T) {
+			aead, err := voiceAEAD(mode, make([]byte, 32))
+			if err != nil {
+				t.Fatal(err)
+			}
+			// RTP X+P+one CSRC; extension preamble remains AAD, its four-byte
+			// extension body is encrypted and removed only after authentication.
+			header := []byte{0xb1, 120, 0, 9, 0, 0, 0, 10, 0, 0, 0, 11, 0, 0, 0, 12, 0xbe, 0xde, 0, 1}
+			payload := []byte{0x10, 0xff, 0, 0, 0xaa, 0xbb, 0, 2}
+			nonce := make([]byte, aead.NonceSize())
+			binary.BigEndian.PutUint32(nonce[:4], 7)
+			wire := append([]byte(nil), header...)
+			wire = aead.Seal(wire, nonce, payload, header)
+			wire = append(wire, nonce[:4]...)
+			plain, ssrc, seq, ts, err := openVoiceRTP(make([]byte, 2048), aead, wire)
+			if err != nil || !bytes.Equal(plain, []byte{0xaa, 0xbb}) || ssrc != 11 || seq != 9 || ts != 10 {
+				t.Fatalf("extension decode: %x %v", plain, err)
+			}
+			bad := append([]byte(nil), wire...)
+			bad[19] = 2
+			if _, _, _, _, err := openVoiceRTP(make([]byte, 2048), aead, bad); err == nil {
+				t.Fatal("extension length not authenticated")
+			}
+			for length := range len(header) {
+				if _, _, _, _, err := openVoiceRTP(make([]byte, 2048), aead, wire[:length]); err == nil {
+					t.Fatalf("truncated RTP accepted %d", length)
+				}
+			}
+		})
+	}
+}
+func TestVoiceOpusFramingAndDuration(t *testing.T) {
+	valid := [][]byte{
+		{0xf8, 0xff, 0xfe},                // CELT single 20 ms frame
+		{0x08, 0xaa},                      // SILK single20
+		{0x91, 0xaa, 0xbb},                // CELT two10ms CBR
+		{0x92, 1, 0xaa, 0xbb},             // CELT two10ms VBR
+		{0x83, 8, 1, 2, 3, 4, 5, 6, 7, 8}, // eight2.5ms CBR
+		{0x93, 0x42, 1, 0xaa, 0xbb, 0},    // two10ms CBR +1byte padding
+	}
+	for _, p := range valid {
+		if err := ValidateOpusPacket(p, 1275); err != nil {
+			t.Fatalf("valid packet %x: %v", p, err)
+		}
+	}
+	invalid := [][]byte{nil, {}, {0x00, 0xaa}, {0x10, 0xaa}, {0x91, 1}, {0x92}, {0x92, 252}, {0x92, 4, 1}, {0x83}, {0x83, 0}, {0x83, 49}, {0x93, 0x42, 255}, {0x93, 0x42, 4, 1}, {0x93, 0x82, 20, 1}}
+	for _, p := range invalid {
+		if ValidateOpusPacket(p, 1275) == nil {
+			t.Fatalf("invalid packet accepted %x", p)
+		}
+	}
+	if ValidateOpusPacket([]byte{0xf8, 0xff, 0xfe}, 2) == nil {
+		t.Fatal("packet byte bound ignored")
+	}
+	if err := validateOpusPacket([]byte{0x10, 0xaa}, 1275, 0); err != nil {
+		t.Fatal("valid incoming40ms must not inherit producer20ms restriction", err)
+	}
+}
+func TestVoiceUnavailableOrdinaryJoin(t *testing.T) {
+	if VoiceAvailable() {
+		t.Skip("ordinary-build boundary only")
+	}
+	s, _ := New("Bot token")
+	if _, err := s.ChannelVoiceJoinContext(context.Background(), "1", "2", true, false, VoiceConfig{}); err != ErrVoiceUnavailable {
+		t.Fatalf("ordinary join: %v", err)
+	}
+}
+func TestVoiceAEADInPlaceSenderStorage(t *testing.T) {
+	for _, mode := range []string{voiceAESMode, voiceXChaChaMode} {
+		t.Run(mode, func(t *testing.T) {
+			aead, err := voiceAEAD(mode, make([]byte, 32))
+			if err != nil {
+				t.Fatal(err)
+			}
+			storage := make([]byte, 2048)
+			frame := []byte{1, 2, 3, 4}
+			copy(storage[12:], frame)
+			packet, err := sealVoiceRTP(storage[:0], aead, 1, 2, 3, 4, storage[12:16])
+			if err != nil {
+				t.Fatal(err)
+			}
+			plain, _, _, _, err := openVoiceRTP(make([]byte, 2048), aead, packet)
+			if err != nil || !bytes.Equal(plain, frame) {
+				t.Fatalf("in-place sender: %x %v", plain, err)
+			}
+		})
+	}
+}
diff --git a/voice_transport.go b/voice_transport.go
new file mode 100644
--- /dev/null
+++ b/voice_transport.go
@@ -0,0 +1,570 @@
+//go:build voice && cgo
+
+package discordgo
+
+import (
+	"context"
+	"crypto/cipher"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/bwmarrin/discordgo/internal/dave"
+	"github.com/gorilla/websocket"
+)
+
+func VoiceAvailable() bool { return dave.MaxSupportedProtocolVersion() > 0 }
+
+type opusHandoff struct {
+	ctx   context.Context
+	opus  []byte
+	reply chan handoffResult
+}
+type handoffResult struct {
+	submission *OpusSubmission
+	err        error
+}
+type voiceMessage struct {
+	kind int
+	data []byte
+}
+
+type nativeVoice struct {
+	v                            *VoiceConnection
+	ctx                          context.Context
+	cancel                       context.CancelFunc
+	mu                           sync.Mutex
+	failure                      error
+	closing                      bool
+	readyFlag                    bool
+	transportReady               bool
+	nativeReadyFlag              bool
+	change                       chan struct{}
+	cleaned                      chan struct{}
+	setupDone                    chan struct{}
+	cleanupErr                   error
+	ws                           *websocket.Conn
+	udp                          *net.UDPConn
+	writer                       chan struct{}
+	udpWriter                    chan struct{}
+	wg                           sync.WaitGroup
+	cryptoMu                     gatewayMutex
+	dave                         *dave.Context
+	aead                         cipher.AEAD
+	mode                         string
+	ssrc                         uint32
+	nonce                        uint64
+	rtpSequence                  uint16
+	rtpTimestamp                 uint32
+	seqAck                       int
+	version                      uint16
+	daveGeneration               uint64
+	resetAuthorizationGeneration uint64
+	resetAuthorizationVersion    uint16
+	resetPackageSent             bool
+	participants                 map[string]struct{}
+	senders                      map[uint32]string
+	external                     []byte
+	resetDeadline                time.Time
+	proposalDeadline             time.Time
+	transitions                  map[uint16]time.Time
+	messages                     chan voiceMessage
+	handoffs                     chan opusHandoff
+	outstanding                  chan struct{}
+	packets                      chan *Packet
+	closeGate                    chan struct{}
+	queueMu                      sync.Mutex
+	queueBytes                   int
+	heartbeatMu                  sync.Mutex
+	heartbeatInterval            time.Duration
+	heartbeatSent                time.Time
+	heartbeatNonce               int64
+	heartbeatPending             bool
+	heartbeatWake                chan struct{}
+}
+
+func newVoiceEngine(v *VoiceConnection) (voiceEngine, error) {
+	c := v.config
+	native, err := dave.New(dave.Config{MaxParticipants: c.MaxParticipants, MaxDecryptors: c.MaxDecryptors, MaxControlBytes: c.MaxWebSocketBytes, MaxProposalCount: c.MaxProposals, MaxProposalBytes: c.MaxProposalBytes, MaxPreparedTransitions: c.MaxTransitions, MaxTransitionBytes: c.MaxTransitionBytes, MaxFrameBytes: c.MaxOpusBytes, MaxEncryptedFrameBytes: c.MaxEncryptedFrameBytes})
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	n := &nativeVoice{v: v, ctx: ctx, cancel: cancel, dave: native, change: make(chan struct{}), cleaned: make(chan struct{}), setupDone: make(chan struct{}), writer: make(chan struct{}, 1), seqAck: -1, participants: map[string]struct{}{v.UserID: {}}, senders: make(map[uint32]string), transitions: make(map[uint16]time.Time), messages: make(chan voiceMessage, c.MaxControlMessages), handoffs: make(chan opusHandoff), outstanding: make(chan struct{}, 1), packets: make(chan *Packet, c.ReceiveQueuePackets), heartbeatWake: make(chan struct{}, 1)}
+	n.udpWriter = make(chan struct{}, 1)
+	n.outstanding <- struct{}{}
+	n.closeGate = make(chan struct{}, 1)
+	n.closeGate <- struct{}{}
+	go n.cleanup()
+	return n, nil
+}
+func (n *nativeVoice) done() <-chan struct{} { return n.cleaned }
+func (n *nativeVoice) err() error            { n.mu.Lock(); defer n.mu.Unlock(); return n.failure }
+func (n *nativeVoice) ready() bool {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	return n.readyFlag && n.failure == nil && !n.closing
+}
+func (n *nativeVoice) changed() <-chan struct{} { n.mu.Lock(); defer n.mu.Unlock(); return n.change }
+func (n *nativeVoice) setReady(ready, native bool) {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	n.nativeReadyFlag = native
+	if n.readyFlag != ready {
+		n.readyFlag = ready
+		close(n.change)
+		n.change = make(chan struct{})
+	}
+}
+func (n *nativeVoice) stop(err error) {
+	if err == nil {
+		err = ErrVoiceClosed
+	}
+	n.mu.Lock()
+	if n.failure != nil {
+		n.mu.Unlock()
+		return
+	}
+	n.failure = err
+	n.readyFlag = false
+	close(n.change)
+	n.change = make(chan struct{})
+	ws, udp := n.ws, n.udp
+	n.mu.Unlock()
+	if ws != nil {
+		_ = ws.Close()
+	}
+	if udp != nil {
+		_ = udp.Close()
+	}
+	n.cancel()
+}
+func (n *nativeVoice) cleanup() {
+	<-n.ctx.Done()
+	<-n.setupDone
+	n.wg.Wait()
+	n.cryptoMu.Lock()
+	n.cleanupErr = n.dave.Close()
+	n.clearPendingResetAuthorization()
+	n.aead = nil
+	clear(n.external)
+	n.external = nil
+	clear(n.participants)
+	clear(n.senders)
+	n.cryptoMu.Unlock()
+	n.mu.Lock()
+	n.ws = nil
+	n.udp = nil
+	n.transportReady = false
+	n.nativeReadyFlag = false
+	n.mu.Unlock()
+	for draining := true; draining; {
+		select {
+		case message := <-n.messages:
+			clear(message.data)
+		default:
+			draining = false
+		}
+	}
+	n.queueMu.Lock()
+	for draining := true; draining; {
+		select {
+		case packet := <-n.packets:
+			n.queueBytes -= len(packet.Opus)
+			clear(packet.Opus)
+		default:
+			draining = false
+		}
+	}
+	n.queueMu.Unlock()
+	n.v.Lock()
+	n.v.token = ""
+	n.v.sessionID = ""
+	n.v.endpoint = ""
+	n.v.Unlock()
+	n.v.finishLocalCleanup()
+	close(n.cleaned)
+}
+func (n *nativeVoice) wait(ctx context.Context) error {
+	select {
+	case <-n.cleaned:
+		return n.cleanupErr
+	default:
+	}
+	select {
+	case <-n.cleaned:
+		return n.cleanupErr
+	case <-ctx.Done():
+		select {
+		case <-n.cleaned:
+			return n.cleanupErr
+		default:
+			return ctx.Err()
+		}
+	}
+}
+func (n *nativeVoice) run(ctx context.Context) (err error) {
+	defer close(n.setupDone)
+	defer func() {
+		if err != nil {
+			n.stop(err)
+		}
+	}()
+	if err = n.v.session.ChannelVoiceJoinManualContext(ctx, n.v.GuildID, n.v.ChannelID, n.v.mute, n.v.deaf); err != nil {
+		return err
+	}
+	for {
+		n.v.Lock()
+		sid, token, endpoint := n.v.sessionID, n.v.token, n.v.endpoint
+		if sid != "" && token != "" && endpoint != "" {
+			n.v.started = true
+			n.v.Unlock()
+			break
+		}
+		n.v.Unlock()
+		select {
+		case <-n.v.credentials:
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-n.ctx.Done():
+			return n.err()
+		}
+	}
+	n.v.RLock()
+	endpoint, sid, token := n.v.endpoint, n.v.sessionID, n.v.token
+	n.v.RUnlock()
+	u, err := url.Parse("wss://" + endpoint)
+	if err != nil || u.Hostname() == "" || u.User != nil || u.Path != "" || u.RawQuery != "" || u.Fragment != "" || strings.Contains(endpoint, "@") {
+		return errors.New("invalid voice endpoint")
+	}
+	u.Path = "/"
+	u.RawQuery = "v=8"
+	dialCtx, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(n.ctx, cancel)
+	dialer := *n.v.session.Dialer
+	dialer.HandshakeTimeout = n.v.config.HandshakeTimeout
+	dialer.ReadBufferSize = n.v.config.MaxWebSocketBytes
+	dialer.WriteBufferSize = n.v.config.MaxWebSocketBytes
+	dialer.EnableCompression = false
+	ws, response, dialErr := dialer.DialContext(dialCtx, u.String(), nil)
+	stop()
+	cancel()
+	if dialErr != nil {
+		if response != nil {
+			if response.Body != nil {
+				response.Body.Close()
+			}
+			if response.StatusCode == 403 {
+				return ErrVoicePermissionDenied
+			}
+		}
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		if n.ctx.Err() != nil {
+			return n.err()
+		}
+		return errors.New("voice websocket connection failed")
+	}
+	n.mu.Lock()
+	if n.failure != nil {
+		n.mu.Unlock()
+		ws.Close()
+		return n.err()
+	}
+	n.ws = ws
+	n.mu.Unlock()
+	ws.SetReadLimit(int64(n.v.config.MaxWebSocketBytes))
+	ws.SetPingHandler(func(data string) error { return n.write(n.ctx, websocket.PongMessage, []byte(data)) })
+	ws.SetCloseHandler(func(int, string) error { return nil })
+	identify := struct {
+		ServerID  string `json:"server_id"`
+		UserID    string `json:"user_id"`
+		SessionID string `json:"session_id"`
+		Token     string `json:"token"`
+		MaxDAVE   uint16 `json:"max_dave_protocol_version"`
+	}{n.v.GuildID, n.v.UserID, sid, token, dave.MaxSupportedProtocolVersion()}
+	if err = n.writeJSON(ctx, 0, identify); err != nil {
+		return err
+	}
+	n.wg.Add(4)
+	go n.readWebSocket()
+	go n.controlLoop()
+	go n.heartbeatLoop()
+	go n.senderLoop()
+	err = n.v.WaitReady(ctx)
+	if errors.Is(err, context.DeadlineExceeded) {
+		n.mu.Lock()
+		daveMissing := n.transportReady && !n.nativeReadyFlag
+		n.mu.Unlock()
+		if daveMissing {
+			return ErrVoiceDAVETimeout
+		}
+	}
+	return err
+}
+func (n *nativeVoice) write(ctx context.Context, kind int, data []byte) error {
+	ctx, cancel := context.WithTimeout(ctx, n.v.config.WriteTimeout)
+	defer cancel()
+	if len(data) > n.v.config.MaxWebSocketBytes {
+		return errors.New("voice control exceeds bound")
+	}
+	select {
+	case n.writer <- struct{}{}:
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-n.ctx.Done():
+		return n.err()
+	}
+	defer func() { <-n.writer }()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	n.mu.Lock()
+	ws := n.ws
+	n.mu.Unlock()
+	if ws == nil {
+		return ErrVoiceClosed
+	}
+	deadline, _ := ctx.Deadline()
+	if err := ws.SetWriteDeadline(deadline); err != nil {
+		return err
+	}
+	callbackDone := make(chan struct{})
+	stop := context.AfterFunc(ctx, func() { _ = ws.Close(); close(callbackDone) })
+	err := ws.WriteMessage(kind, data)
+	if !stop() {
+		<-callbackDone
+	}
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	if err != nil {
+		return errors.New("voice websocket write failed")
+	}
+	return nil
+}
+func (n *nativeVoice) writeJSON(ctx context.Context, op int, value any) error {
+	b, err := json.Marshal(struct {
+		Op int `json:"op"`
+		D  any `json:"d"`
+	}{op, value})
+	if err != nil {
+		return err
+	}
+	defer clear(b)
+	return n.write(ctx, websocket.TextMessage, b)
+}
+func (n *nativeVoice) writeBinary(ctx context.Context, op byte, value []byte) error {
+	if len(value) >= n.v.config.MaxWebSocketBytes {
+		return errors.New("voice binary exceeds bound")
+	}
+	b := make([]byte, len(value)+1)
+	b[0] = op
+	copy(b[1:], value)
+	defer clear(b)
+	return n.write(ctx, websocket.BinaryMessage, b)
+}
+func (n *nativeVoice) readWebSocket() {
+	defer n.wg.Done()
+	for {
+		kind, b, err := n.ws.ReadMessage()
+		if err != nil {
+			var closed *websocket.CloseError
+			if errors.As(err, &closed) && (closed.Code == 4012 || closed.Code == 4016 || closed.Code == 4017) {
+				n.stop(ErrVoiceUnavailable)
+			} else {
+				n.stop(errors.New("voice websocket lost"))
+			}
+			return
+		}
+		if kind != websocket.TextMessage && kind != websocket.BinaryMessage {
+			clear(b)
+			continue
+		}
+		select {
+		case n.messages <- voiceMessage{kind, b}:
+		case <-n.ctx.Done():
+			clear(b)
+			return
+		default:
+			clear(b)
+			n.stop(errors.New("voice control mailbox exhausted"))
+			return
+		}
+	}
+}
+func (n *nativeVoice) handleVoiceMessage(message voiceMessage) error {
+	defer clear(message.data)
+	if err := n.cryptoMu.lockContext(n.ctx); err != nil {
+		return err
+	}
+	defer n.cryptoMu.Unlock()
+	if err := n.err(); err != nil {
+		n.clearPendingResetAuthorization()
+		return err
+	}
+	err := n.control(message)
+	if err != nil {
+		n.clearPendingResetAuthorization()
+	}
+	n.heartbeatMu.Lock()
+	helloReceived := n.heartbeatInterval > 0
+	n.heartbeatMu.Unlock()
+	nativeReady := n.dave.Ready()
+	n.setReady(helloReceived && n.aead != nil && nativeReady, nativeReady)
+	return err
+}
+func (n *nativeVoice) controlLoop() {
+	defer n.wg.Done()
+	timer := time.NewTimer(n.v.config.RekeyTimeout)
+	if !timer.Stop() {
+		<-timer.C
+	}
+	defer timer.Stop()
+	for {
+		select {
+		case <-n.ctx.Done():
+			return
+		case message := <-n.messages:
+			if err := n.handleVoiceMessage(message); err != nil {
+				n.stop(err)
+				return
+			}
+		case <-timer.C:
+		}
+		n.cryptoMu.Lock()
+		deadline := n.nextRekeyDeadline()
+		n.cryptoMu.Unlock()
+		if !timer.Stop() {
+			select {
+			case <-timer.C:
+			default:
+			}
+		}
+		if !deadline.IsZero() {
+			if !time.Now().Before(deadline) {
+				n.stop(ErrVoiceDAVETimeout)
+				return
+			}
+			timer.Reset(time.Until(deadline))
+		}
+	}
+}
+func (n *nativeVoice) submit(ctx context.Context, p []byte) (*OpusSubmission, error) {
+	if err := ValidateOpusPacket(p, n.v.config.MaxOpusBytes); err != nil {
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if !n.ready() {
+		if err := n.err(); err != nil {
+			return nil, err
+		}
+		return nil, ErrVoiceNotReady
+	}
+	select {
+	case <-n.outstanding:
+	default:
+		return nil, ErrVoiceInFlight
+	}
+	release := true
+	defer func() {
+		if release {
+			n.outstanding <- struct{}{}
+		}
+	}()
+	submitCtx, cancel := context.WithTimeout(ctx, n.v.config.SubmitTimeout)
+	defer cancel()
+	request := opusHandoff{ctx: submitCtx, opus: p, reply: make(chan handoffResult, 1)}
+	select {
+	case n.handoffs <- request:
+	case <-submitCtx.Done():
+		return nil, submitCtx.Err()
+	case <-n.ctx.Done():
+		return nil, n.err()
+	}
+	// Once the sender receives the request, it alone decides whether ownership was
+	// transferred. Always await that decision, even if the submit context cancels.
+	result := <-request.reply
+	if result.err != nil {
+		return nil, result.err
+	}
+	release = false
+	return result.submission, nil
+}
+func (n *nativeVoice) receive(ctx context.Context) (*Packet, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if n.ctx.Err() != nil {
+		return nil, n.err()
+	}
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case <-n.ctx.Done():
+		return nil, n.err()
+	case packet := <-n.packets:
+		n.queueMu.Lock()
+		n.queueBytes -= len(packet.Opus)
+		n.queueMu.Unlock()
+		if n.ctx.Err() != nil {
+			return nil, n.err()
+		}
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		return packet, nil
+	}
+}
+func (n *nativeVoice) shutdown(ctx context.Context) error {
+	ctx, cancel := context.WithTimeout(ctx, n.v.config.CloseTimeout)
+	defer cancel()
+	select {
+	case <-n.closeGate:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	defer func() { n.closeGate <- struct{}{} }()
+	n.mu.Lock()
+	if n.failure != nil {
+		n.mu.Unlock()
+		return n.wait(ctx)
+	}
+	n.closing = true
+	n.readyFlag = false
+	close(n.change)
+	n.change = make(chan struct{})
+	ws := n.ws
+	n.mu.Unlock()
+	// Admission is closed. Wait for the sole non-retractable handoff to complete
+	// before clearing speaking, then close all real sockets and native owners.
+	select {
+	case <-n.outstanding:
+		defer func() { n.outstanding <- struct{}{} }()
+	case <-n.ctx.Done():
+		return n.wait(ctx)
+	case <-ctx.Done():
+		n.stop(ctx.Err())
+		return ctx.Err()
+	}
+	var speakingErr error
+	if ws != nil {
+		speakingErr = n.speaking(ctx, false)
+	}
+	if ws != nil && speakingErr == nil {
+		speakingErr = n.write(ctx, websocket.CloseMessage, websocket.FormatCloseMessage(websocket.CloseNormalClosure, ""))
+	}
+	if speakingErr != nil {
+		n.stop(speakingErr)
+	} else {
+		n.stop(ErrVoiceClosed)
+	}
+	return errors.Join(speakingErr, n.wait(ctx))
+}
