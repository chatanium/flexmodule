+/* Chatanium host-only source extensions to pinned libdave v1.2.2/cpp.
+ * Base commit: 6396c90aedbb9a6ee117ea9ce1ce9832af6a3375.
+ * This is a source-patched fork, not the unmodified upstream release ABI.
+ */
+#pragma once
+#include <dave/dave.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Configure finite limits before any ProcessProposals call. Limits survive
+ * session Reset/Init; current queued bytes are cleared with pending state. */
+DAVE_EXPORT bool flexDaveSessionSetProposalLimits(DAVESessionHandle session,
+                                                  size_t maxCount,
+                                                  size_t maxBytes);
+/* Authorize media export from a local pending group only after verified gateway
+ * transition zero. Does not establish MLS, consume the join key package, choose
+ * a winning commit, or expose/serialize any private state. */
+DAVE_EXPORT bool flexDaveSessionActivatePendingGroup(DAVESessionHandle session);
+#ifdef __cplusplus
+}
+#endif
