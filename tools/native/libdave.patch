+bool Session::SetProposalLimits(size_t maxCount, size_t maxBytes) noexcept
+{
+    if (maxCount == 0 || maxBytes == 0 || !proposalQueue_.empty()) {
+        return false;
+    }
+    proposalCountLimit_ = maxCount;
+    proposalBytesLimit_ = maxBytes;
+    return true;
+}
+
+bool Session::ActivatePendingGroup() noexcept
+try {
+    if (protocolVersion_ == 0 || protocolVersion_ > MaxSupportedProtocolVersion() ||
+        currentState_ || !pendingGroupState_ || !joinKeyPackage_ ||
+        !joinInitPrivateKey_ || !selfSigPrivateKey_ || !externalSender_) {
+        return false;
+    }
+    const auto& state = *pendingGroupState_;
+    const auto& roster = state.roster();
+    if (state.epoch() != 0 || roster.size() != 1 ||
+        state.cipher_suite().cipher_suite() != CiphersuiteIDForProtocolVersion(protocolVersion_) ||
+        state.extensions().extensions.size() != 1 ||
+        roster.front().credential.type() != ::mlspp::CredentialType::basic ||
+        roster.front().signature_key.data != selfSigPrivateKey_->public_key.data ||
+        !VerifyWelcomeState(state, std::set<std::string>{selfUserId_})) {
+        return false;
+    }
+    // This authorizes only media export for a verified transition zero. Do NOT
+    // call ReplaceState: the local MLS group remains unestablished and can still
+    // accept another member's winning welcome and its original join key package.
+    pendingMediaActivated_ = true;
+    return true;
+}
+catch (const std::exception&) {
+    return false;
+}
